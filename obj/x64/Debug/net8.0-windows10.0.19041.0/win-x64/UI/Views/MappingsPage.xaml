<?xml version="1.0" encoding="utf-8"?>
<Page x:ConnectionId='1'
    x:Class="ArcanePlayConnect.UI.Views.MappingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ArcanePlayConnect.UI.ViewModels"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:ActionTypeToBrushConverter x:Key="ActionTypeToBrush" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="ACTION MAPPINGS" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource NeonPurpleBrush}" CharacterSpacing="100" />
            <TextBlock Text="Map TikTok events to RCON commands"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Mapping list -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="12">
            <ListView x:ConnectionId='3' x:Name="MappingsList"
                                                                                   
                      Background="Transparent" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate                                  >
                        <Grid x:ConnectionId='5' Padding="8,10" ColumnSpacing="10" Margin="0,2"
                              Background="#FF1E1E36" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Type icon -->
                            <Border x:ConnectionId='6' Grid.Column="0" CornerRadius="4" Padding="6,4"
                                    VerticalAlignment="Center"
                                                                                                                                
                                    Opacity="0.2">
                                <TextBlock x:ConnectionId='12'                                  FontSize="14"
                                           FontFamily="Segoe MDL2 Assets"
                                                                                                                                        />
                            </Border>

                            <!-- Trigger display -->
                            <TextBlock x:ConnectionId='7' Grid.Column="1"                               
                                                                                                                                   
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       MinWidth="100" />

                            <!-- Arrow -->
                            <TextBlock Grid.Column="2" Text="&#x2192;" FontSize="12"
                                       Foreground="#FF8888AA" VerticalAlignment="Center" />

                            <!-- Action display: command or button -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon x:ConnectionId='10'                              FontFamily="Segoe MDL2 Assets"
                                          FontSize="11"                                   />
                                <TextBlock x:ConnectionId='11'                              
                                                                             FontSize="11"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Opacity="0.85" />
                            </StackPanel>

                            <!-- Test -->
                            <Button x:ConnectionId='8' Grid.Column="4"                                         
                                    Background="Transparent" BorderThickness="0" Padding="6,4"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Test this mapping">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="{StaticResource NeonGreenBrush}" />
                            </Button>

                            <!-- Remove -->
                            <Button x:ConnectionId='9' Grid.Column="5"                                           
                                    Background="Transparent" BorderThickness="0" Padding="6,4"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Remove this mapping">
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="{StaticResource NeonPinkBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Add button -->
        <Button x:ConnectionId='2' Grid.Row="4"                         
                Style="{StaticResource CyberpunkAccentButtonStyle}"
                HorizontalAlignment="Stretch" Padding="0,12" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                <TextBlock Text="Add Action Mapping" />
            </StackPanel>
        </Button>
    </Grid>
</Page>

