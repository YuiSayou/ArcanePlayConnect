<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="ArcanePlayConnect.UI.Controls.CommandBuilderPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Step 1: Category selector -->
        <StackPanel x:ConnectionId='2' x:Name="CategoryPanel" Grid.Row="0" Spacing="6">
            <TextBlock Text="SELECT CATEGORY" FontSize="10" FontWeight="Bold"
                       Foreground="#FF8888AA" CharacterSpacing="120" />
            <ItemsControl x:ConnectionId='28' x:Name="CategoryList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:ConnectionId='29' CornerRadius="4" Padding="10,6"
                                Background="#FF16162A" BorderThickness="1" BorderBrush="#FF1A1A2E"
                                                                         Tag="{Binding}">
                            <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF8888AA" CharacterSpacing="80" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Step 2: Command selector -->
        <StackPanel x:ConnectionId='3' x:Name="CommandPanel" Grid.Row="1" Spacing="6" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='26' Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                    
                        Background="Transparent" Foreground="#FF00C8FF" BorderThickness="0" Padding="6,4"
                        VerticalAlignment="Center" />
                <TextBlock x:ConnectionId='27' x:Name="CommandPanelHeader" Grid.Column="1" FontSize="10" FontWeight="Bold"
                           Foreground="#FF00C8FF" CharacterSpacing="120" VerticalAlignment="Center" />
            </Grid>
            <ItemsControl x:ConnectionId='24' x:Name="CommandList">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:ConnectionId='25' CornerRadius="4" Padding="10,6"
                                Background="#FF16162A" BorderThickness="1" BorderBrush="#FF1A1A2E"
                                                                        Tag="{Binding}">
                            <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                       Foreground="#FF00FF88" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Step 3: Argument steps -->
        <StackPanel x:ConnectionId='4' x:Name="StepsPanel" Grid.Row="2" Spacing="8" Visibility="Collapsed" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='21' Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   
                        Background="Transparent" Foreground="#FF00C8FF" BorderThickness="0" Padding="6,4"
                        VerticalAlignment="Center" />
                <TextBlock x:ConnectionId='22' x:Name="StepsPanelHeader" Grid.Column="1" FontSize="10" FontWeight="Bold"
                           Foreground="#FF00FF88" CharacterSpacing="120" VerticalAlignment="Center" />
                <TextBlock x:ConnectionId='23' x:Name="StepCounter" Grid.Column="2" FontSize="9"
                           Foreground="#FF8888AA" VerticalAlignment="Center" />
            </Grid>

            <!-- Current step UI -->
            <Border x:ConnectionId='7' x:Name="CurrentStepBorder" Background="#FF12121E" CornerRadius="6" Padding="12,10">
                <StackPanel Spacing="6">
                    <TextBlock x:ConnectionId='11' x:Name="StepLabel" FontSize="11" FontWeight="Bold" Foreground="#FF00C8FF" />
                    <TextBlock x:ConnectionId='12' x:Name="StepHint" FontSize="9" Foreground="#FF8888AA" />

                    <!-- Options (filterable list for steps with choices) -->
                    <StackPanel x:ConnectionId='13' x:Name="OptionsPanel" Spacing="4">
                        <AutoSuggestBox x:ConnectionId='18' x:Name="OptionFilter" PlaceholderText="Search..."
                                        QueryIcon="Find"
                                        Background="#FF0D0D1A" Foreground="#FFE0E0FF"
                                        FontSize="11"
                                                                               />
                        <ListView x:ConnectionId='19' x:Name="OptionsList" MaxHeight="150"
                                  Background="Transparent"
                                  SelectionMode="Single"
                                  IsItemClickEnabled="True"
                                                              
                                  Padding="2">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="8,4" Background="Transparent">
                                        <TextBlock Text="{Binding}" FontSize="11" FontFamily="Consolas"
                                                   Foreground="#FF00FF88" />
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>

                    <!-- Free text input (for coordinates, numbers, etc.) -->
                    <StackPanel x:ConnectionId='14' x:Name="FreeTextPanel" Visibility="Collapsed" Spacing="4">
                        <TextBox x:ConnectionId='15' x:Name="FreeTextBox"
                                 Background="#FF0D0D1A" Foreground="#FF00FF88"
                                 BorderBrush="#FF1A1A2E" BorderThickness="1"
                                 Padding="10,7" CornerRadius="4" FontSize="12"
                                 FontFamily="Consolas" />
                        <!-- Quick-pick buttons for coordinate/nbt presets -->
                        <ItemsControl x:ConnectionId='16' x:Name="PresetsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:ConnectionId='17' CornerRadius="3" Padding="8,3"
                                            Background="#FF1A1A2E" BorderThickness="1" BorderBrush="#FF262640"
                                                                                   Tag="{Binding}">
                                        <TextBlock Text="{Binding}" FontSize="9" FontFamily="Consolas"
                                                   Foreground="#FF00C8FF" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Navigation -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='8' x:Name="SkipBtn" Grid.Column="0" Content="Skip (optional)"                   
                        Background="#FF1E1E36" Foreground="#FF8888AA"
                        BorderBrush="#FF1A1A2E" BorderThickness="1"
                        CornerRadius="4" FontSize="10" Padding="10,5" Visibility="Collapsed" />
                <Button x:ConnectionId='9' x:Name="NextBtn" Grid.Column="2"                   
                        CornerRadius="4" FontSize="11" FontWeight="Bold" Padding="14,6"
                        Foreground="White" BorderThickness="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF00C8FF" Offset="0" />
                            <GradientStop Color="#FFB400FF" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:ConnectionId='10' x:Name="NextBtnText" Text="Next" />
                        <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Preview -->
        <Border x:ConnectionId='5' x:Name="PreviewBorder" Grid.Row="3" Margin="0,8,0,0"
                Background="#FF0D0D1A" CornerRadius="4" Padding="10,6"
                BorderBrush="#FF1A1A2E" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Spacing="2">
                <TextBlock Text="PREVIEW" FontSize="8" FontWeight="Bold"
                           Foreground="#FF8888AA" CharacterSpacing="120" />
                <TextBlock x:ConnectionId='6' x:Name="PreviewText" FontSize="11" FontFamily="Consolas"
                           Foreground="#FF00FF88" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

