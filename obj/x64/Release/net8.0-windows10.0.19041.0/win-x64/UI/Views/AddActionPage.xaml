<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.AddActionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArcanePlayConnect.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ArcanePlayConnect.Core.Models"
    Background="#FF0A0A14"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!--  ??? LEFT: Main form ???  -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Header  -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="#FF00C8FF"
                            Glyph="&#xE945;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="120"
                            FontSize="15"
                            FontWeight="Bold"
                            Foreground="#FF00C8FF"
                            Text="ADD ACTION MAPPING" />
                    </StackPanel>
                    <Border Height="1" Margin="0,6,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0.0" Color="#FF00C8FF" />
                                <GradientStop Offset="0.5" Color="#FFB400FF" />
                                <GradientStop Offset="1.0" Color="#FFFF3278" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!--  Trigger Type selector  -->
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock
                        CharacterSpacing="120"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#FF8888AA"
                        Text="TRIGGER TYPE" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:ConnectionId='35'
                            x:Name="GiftTypeBtn"
                            Grid.Column="0"
                            Padding="10,10"
                            Background="#FF1E1E36"
                            BorderBrush="#FFFF3278"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Gift">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FFFF3278"
                                    Glyph="&#xE8E1;" />
                                <TextBlock x:ConnectionId='48'
                                    x:Name="GiftLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FFFF3278"
                                    Text="GIFT" />
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='36'
                            x:Name="FollowTypeBtn"
                            Grid.Column="1"
                            Padding="10,10"
                            Background="#FF16162A"
                            BorderBrush="#FF1A1A2E"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Follow">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FF8888AA"
                                    Glyph="&#xE77B;" />
                                <TextBlock x:ConnectionId='47'
                                    x:Name="FollowLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8888AA"
                                    Text="FOLLOW" />
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='37'
                            x:Name="ChatTypeBtn"
                            Grid.Column="2"
                            Padding="10,10"
                            Background="#FF16162A"
                            BorderBrush="#FF1A1A2E"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Chat">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FF8888AA"
                                    Glyph="&#xE8BD;" />
                                <TextBlock x:ConnectionId='46'
                                    x:Name="ChatLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8888AA"
                                    Text="CHAT" />
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='38'
                            x:Name="LikeTypeBtn"
                            Grid.Column="3"
                            Padding="10,10"
                            Background="#FF16162A"
                            BorderBrush="#FF1A1A2E"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Like">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FF8888AA"
                                    Glyph="&#xEB51;" />
                                <TextBlock x:ConnectionId='45'
                                    x:Name="LikeLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8888AA"
                                    Text="LIKE" />
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='39'
                            x:Name="JoinTypeBtn"
                            Grid.Column="4"
                            Padding="10,10"
                            Background="#FF16162A"
                            BorderBrush="#FF1A1A2E"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Join">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FF8888AA"
                                    Glyph="&#xE72A;" />
                                <TextBlock x:ConnectionId='44'
                                    x:Name="JoinLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8888AA"
                                    Text="JOIN" />
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='40'
                            x:Name="ShareTypeBtn"
                            Grid.Column="5"
                            Padding="10,10"
                            Background="#FF16162A"
                            BorderBrush="#FF1A1A2E"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Share">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FF8888AA"
                                    Glyph="&#xE72D;" />
                                <TextBlock x:ConnectionId='43'
                                    x:Name="ShareLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8888AA"
                                    Text="SHARE" />
                            </StackPanel>
                        </Border>

                        <Border x:ConnectionId='41'
                            x:Name="SubscribeTypeBtn"
                            Grid.Column="6"
                            Padding="10,10"
                            Background="#FF16162A"
                            BorderBrush="#FF1A1A2E"
                            BorderThickness="2"
                            CornerRadius="6"
                                                                       
                            Tag="Subscribe">
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="22"
                                    Foreground="#FF8888AA"
                                    Glyph="&#xE8FA;" />
                                <TextBlock x:ConnectionId='42'
                                    x:Name="SubscribeLabel"
                                    HorizontalAlignment="Center"
                                    CharacterSpacing="100"
                                    FontSize="10"
                                    FontWeight="Bold"
                                    Foreground="#FF8888AA"
                                    Text="SUB" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!--  Trigger Key  -->
                <StackPanel x:ConnectionId='8'
                    x:Name="TriggerKeyPanel"
                    Grid.Row="4"
                    Spacing="6">
                    <TextBlock x:ConnectionId='23'
                        x:Name="TriggerKeyLabel"
                        Text="GIFT NAME"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="#FF8888AA"
                        CharacterSpacing="120" />

                    <!--  Gift picker (visible only for Gift type)  -->
                    <StackPanel x:ConnectionId='24' x:Name="GiftPickerPanel" Spacing="6" Visibility="Collapsed">
                        <AutoSuggestBox x:ConnectionId='26'
                            x:Name="GiftSuggestBox"
                            PlaceholderText="Search gifts to add..."
                            Background="#FF12121E" Foreground="#FFE0E0FF"
                            BorderBrush="#FF1A1A2E" BorderThickness="1"
                            FontSize="13"
                                                                    
                                                                              
                                                                          
                                                              
                            UpdateTextOnSelect="False">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate                               >
                                    <Grid x:ConnectionId='31' Padding="4,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="4"
                                            Background="#FF1A1A2E">
                                            <Image x:ConnectionId='34'
                                                                                 
                                                Stretch="UniformToFill"
                                                Width="28" Height="28" />
                                        </Border>
                                        <TextBlock x:ConnectionId='32'
                                            Grid.Column="1"
                                                                
                                            Foreground="#FFE0E0FF" FontSize="12" FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="2"
                                            Orientation="Horizontal" Spacing="3"
                                            VerticalAlignment="Center">
                                            <TextBlock x:ConnectionId='33'
                                                                           
                                                FontSize="11"
                                                Foreground="#FFFF9500" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>

                        <!--  Selected gifts display  -->
                        <Border x:ConnectionId='27'
                            x:Name="SelectedGiftsBorder"
                            CornerRadius="6"
                            Background="#FF12121E" BorderBrush="#FF1A1A2E" BorderThickness="1"
                            Padding="8" MinHeight="36" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock x:ConnectionId='28'
                                    x:Name="SelectedGiftsCountText"
                                    FontSize="9"
                                    Foreground="#FF8888AA"
                                    Margin="0,0,0,4"
                                    Text="0 gifts selected" />
                                <ItemsControl x:ConnectionId='29' x:Name="SelectedGiftsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Plain TextBox for non-gift trigger types  -->
                    <TextBox x:ConnectionId='25'
                        x:Name="TriggerKeyBox"
                        Padding="10,8"
                        Background="#FF12121E"
                        BorderBrush="#FF1A1A2E"
                        BorderThickness="1"
                        CornerRadius="4"
                        FontSize="13"
                        Foreground="#FFE0E0FF"
                        PlaceholderText="e.g. Rose"
                        Visibility="Collapsed" />
                </StackPanel>

                <!--  Command / Button Action  -->
                <StackPanel Grid.Row="6" Spacing="6">
                    <!--  Action mode selector  -->
                    <StackPanel Spacing="5">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#FF8888AA"
                            Text="ACTION" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:ConnectionId='19'
                                x:Name="ActionCommandBtn"
                                Grid.Column="0"
                                Padding="8,8"
                                Background="#FF1E1E36"
                                BorderBrush="#FF00FF88"
                                BorderThickness="2"
                                CornerRadius="6"
                                                                          
                                Tag="Command">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="#FF00FF88"
                                        Glyph="&#xE756;" />
                                    <TextBlock x:ConnectionId='22'
                                        x:Name="ActionCommandLabel"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF00FF88"
                                        Text="RCON Command" />
                                </StackPanel>
                            </Border>
                            <Border x:ConnectionId='20'
                                x:Name="ActionButtonBtn"
                                Grid.Column="1"
                                Padding="8,8"
                                Background="#FF16162A"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="2"
                                CornerRadius="6"
                                                                          
                                Tag="Button">
                                <StackPanel
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="8">
                                    <FontIcon
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="#FF8888AA"
                                        Glyph="&#xE946;" />
                                    <TextBlock x:ConnectionId='21'
                                        x:Name="ActionButtonLabel"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF8888AA"
                                        Text="Trigger Button" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!--  Command input panel  -->
                    <StackPanel x:ConnectionId='11' x:Name="CommandPanel" Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                CharacterSpacing="120"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="#FF8888AA"
                                Text="RCON COMMAND" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="9"
                                FontWeight="SemiBold"
                                Foreground="#FF00FF88"
                                Text="use {nickname} for player name" />
                        </Grid>
                        <controls:CommandSuggestionBox x:ConnectionId='14'
                            x:Name="CommandBox"
                            PlaceholderText="e.g. execute as {username} at @s run summon zombie ^ ^ ^2 {CustomName:&quot;{nickname}&quot;,CustomNameVisible:1b}"
                                                                 />
                        <Border x:ConnectionId='15'
                            x:Name="CommandHintBorder"
                            Padding="8,5"
                            Background="#FF0D1F0D"
                            BorderBrush="#FF00FF88"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock x:ConnectionId='18'
                                x:Name="CommandHintText"
                                FontFamily="Consolas"
                                FontSize="9"
                                Foreground="#FF00FF88"
                                Text="Type braces normally: {CustomName:...}  &#x0A;Use {nickname} where you want the player name."
                                TextWrapping="Wrap" />
                        </Border>

                        <!--  Save command row  -->
                        <Grid Margin="0,4,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:ConnectionId='16'
                                x:Name="SaveLabelBox"
                                Grid.Column="0"
                                Padding="10,7"
                                Background="#FF12121E"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="1"
                                CornerRadius="4"
                                FontSize="11"
                                Foreground="#FFE0E0FF"
                                PlaceholderText="Label to save as..." />
                            <Button x:ConnectionId='17'
                                Grid.Column="1"
                                Padding="10,7"
                                Background="#FF1E1E36"
                                BorderBrush="#FF00FF88"
                                BorderThickness="1"
                                                         
                                Content="Save to Library"
                                CornerRadius="4"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="#FF00FF88" />
                        </Grid>
                    </StackPanel>

                    <!--  Button selector panel  -->
                    <StackPanel x:ConnectionId='12'
                        x:Name="ButtonPanel"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="#FF8888AA"
                            Text="SELECT BUTTON" />
                        <ComboBox x:ConnectionId='13'
                            x:Name="ButtonCombo"
                            HorizontalAlignment="Stretch"
                            Background="#FF12121E"
                            FontSize="12"
                            PlaceholderText="Choose a command button..." />
                        <Border
                            Padding="8,5"
                            Background="#FF1F1A0D"
                            BorderBrush="#FFFF9500"
                            BorderThickness="1"
                            CornerRadius="4">
                            <TextBlock
                                FontSize="9"
                                Foreground="#FFFF9500"
                                Text="Create buttons in the Command Buttons page first. The selected button's full command sequence will run when this mapping triggers."
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!--  Action Buttons  -->
                <Grid Grid.Row="8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:ConnectionId='9'
                        Grid.Column="0"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        Background="#FF1E1E36"
                        BorderBrush="#FFFF3278"
                        BorderThickness="1"
                                            
                        Content="Cancel"
                        CornerRadius="4"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="#FFFF3278" />

                    <Button x:ConnectionId='10'
                        Grid.Column="1"
                        Padding="0,10"
                        HorizontalAlignment="Stretch"
                        BorderThickness="0"
                                         
                        Content="Add Action"
                        CornerRadius="4"
                        FontSize="13"
                        FontWeight="Bold"
                        Foreground="White">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Offset="0.0" Color="#FF00C8FF" />
                                <GradientStop Offset="1.0" Color="#FFB400FF" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!--  Divider  -->
        <Border Grid.Column="1" Background="#FF1A1A2E" />

        <!--  ??? RIGHT: Saved commands library ???  -->
        <Grid Grid.Column="2" Background="#FF0D0D1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Library header  -->
            <Border
                Grid.Row="0"
                Padding="12,14,12,10"
                BorderBrush="#FF1A1A2E"
                BorderThickness="0,0,0,1">
                <TextBlock
                    CharacterSpacing="120"
                    FontSize="10"
                    FontWeight="Bold"
                    Foreground="#FF00FF88"
                    Text="COMMAND LIBRARY" />
            </Border>

            <!--  Saved command list  -->
            <ListView x:ConnectionId='2'
                x:Name="SavedCommandsList"
                Grid.Row="1"
                Padding="6,4"
                Background="Transparent"
                IsItemClickEnabled="True"
                                                  
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate                                 >
                        <Grid x:ConnectionId='4' Padding="6,6" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock x:ConnectionId='6'
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FFE0E0FF"
                                                         
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock x:ConnectionId='7'
                                    FontFamily="Consolas"
                                    FontSize="9"
                                    Foreground="#FF8888AA"
                                                           
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button x:ConnectionId='5'
                                Grid.Column="1"
                                Padding="4,2"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                                                
                                Content="&#xE74D;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="#FF8888AA"
                                               />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

