<?xml version="1.0" encoding="utf-8" ?>
<Page x:ConnectionId='1'
    x:Class="ArcanePlayConnect.UI.Views.EventLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="PageRoot"
    Background="{StaticResource DarkBgBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:LogCategoryToBrushConverter x:Key="LogCategoryToBrush" />
        <conv:LogCategoryToTagConverter x:Key="LogCategoryToTag" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    CharacterSpacing="100"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="{StaticResource NeonGreenBrush}"
                    Text="EVENT LOG" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Real-time event stream from TikTok" />
            </StackPanel>
            <Button x:ConnectionId='13'
                Grid.Column="1"
                Margin="0,0,8,0"
                Padding="12,6"
                VerticalAlignment="Top"
                                                             
                FontSize="11"
                Style="{StaticResource CyberpunkDangerButtonStyle}"
                ToolTipService.ToolTip="Clear all logs">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Glyph="&#xE74D;" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <Button x:ConnectionId='14'
                Grid.Column="2"
                Padding="12,6"
                VerticalAlignment="Top"
                                                               
                FontSize="11"
                Style="{StaticResource CyberpunkButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Glyph="&#xE8C8;" />
                    <TextBlock Text="Copy All" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Filters  -->
        <Border
            Grid.Row="2"
            Padding="14,8"
            Background="{StaticResource DarkBg2Brush}"
            CornerRadius="6">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox x:ConnectionId='5'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                              >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FF888888" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="System" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='6'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                            >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FF00C8FF" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Chat" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='7'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                              >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFB400FF" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Follow" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='8'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                            >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFFF3278" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Gift" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='9'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                            >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFFF5050" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Like" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='10'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                             >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFFF9500" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Share" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='11'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                                 >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FFFFD700" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Subscribe" />
                    </StackPanel>
                </CheckBox>
                <CheckBox x:ConnectionId='12'
                    MinWidth="0"
                    Padding="4,0,0,0"
                                                                               >
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="#FF00FF88" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Webhook" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!--  Log list  -->
        <Border
            Grid.Row="4"
            Padding="8"
            Style="{StaticResource PanelBorderStyle}">
            <ListView x:ConnectionId='2'
                x:Name="LogListView"
                Background="Transparent"
                                                                               
                IsItemClickEnabled="False"
                                                                          
                SelectionMode="Single">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem x:ConnectionId='4'                            Text="Copy">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Copy" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="10"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{Binding FormattedTime}" />
                            <Border
                                Grid.Column="1"
                                Padding="5,2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{Binding Category, Converter={StaticResource LogCategoryToBrush}}"
                                CornerRadius="3"
                                Opacity="0.18">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="Bold"
                                    Foreground="{Binding Category, Converter={StaticResource LogCategoryToBrush}}"
                                    Text="{Binding Category, Converter={StaticResource LogCategoryToTag}}" />
                            </Border>
                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsTextSelectionEnabled="True"
                                Text="{Binding Message}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>

