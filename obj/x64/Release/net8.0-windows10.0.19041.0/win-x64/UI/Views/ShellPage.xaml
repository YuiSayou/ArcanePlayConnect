<?xml version="1.0" encoding="utf-8" ?>
<Page x:ConnectionId='1'
    x:Class="ArcanePlayConnect.UI.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Shell"
    Background="{StaticResource DarkBgBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ??????? LEFT NAV RAIL ???????  -->
        <Border
            Grid.Column="0"
            Background="#FF0D0D1A"
            BorderBrush="{StaticResource DarkBg3Brush}"
            BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  App branding  -->
                <Border Grid.Row="0" Padding="16,16,16,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="20"
                                Foreground="{StaticResource NeonBlueBrush}"
                                Glyph="&#xE945;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="80"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="{StaticResource NeonBlueBrush}"
                                Text="ARCANE PLAY" />
                        </StackPanel>
                        <TextBlock
                            Margin="28,0,0,0"
                            CharacterSpacing="200"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="CONNECT" />
                        <!--  Gradient line  -->
                        <Border
                            Height="2"
                            Margin="0,6,0,0"
                            CornerRadius="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#FF00C8FF" />
                                    <GradientStop Offset="0.5" Color="#FFB400FF" />
                                    <GradientStop Offset="1" Color="#FFFF3278" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Nav items  -->
                <StackPanel
                    Grid.Row="1"
                    Padding="8,4"
                    Spacing="2">
                    <Button x:ConnectionId='8'
                        x:Name="NavDashboard"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Dashboard">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource NeonBlueBrush}"
                                Glyph="&#xE80F;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Dashboard" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='9'
                        x:Name="NavEventLog"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="EventLog">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource NeonGreenBrush}"
                                Glyph="&#xE7BA;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Event Log" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='10'
                        x:Name="NavTriggers"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Triggers">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource NeonPurpleBrush}"
                                Glyph="&#xE8CB;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Triggers" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='11'
                        x:Name="NavActions"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Actions">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="#FFFF9500"
                                Glyph="&#xE946;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Actions" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='12'
                        x:Name="NavMinecraft"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Minecraft">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource NeonGreenBrush}"
                                Glyph="&#xE968;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Minecraft" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='13'
                        x:Name="NavOverlays"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Overlays">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource NeonGreenBrush}"
                                Glyph="&#xE774;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Overlays" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='14'
                        x:Name="NavFollowers"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Followers">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="#FFB400FF"
                                Glyph="&#xE77B;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Follower Database" />
                        </StackPanel>
                    </Button>

                    <Button x:ConnectionId='15'
                        x:Name="NavProfiles"
                        Padding="12,10"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                                               
                        CornerRadius="6"
                        Tag="Profiles">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="16"
                                Foreground="{StaticResource NeonPinkBrush}"
                                Glyph="&#xE748;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="Profiles" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Spacer  -->
                <Border Grid.Row="2" />

                <!--  Status indicators  -->
                <Border
                    Grid.Row="3"
                    Padding="16,8"
                    Background="#FF0A0A14"
                    BorderBrush="{StaticResource DarkBg3Brush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock
                            CharacterSpacing="200"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="STATUS" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:ConnectionId='6'
                                Grid.Column="0"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                                                                                                                       />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="TikTok" />
                            <TextBlock x:ConnectionId='7'
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                                        />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:ConnectionId='4'
                                Grid.Column="0"
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                                                                                                                     />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="RCON" />
                            <TextBlock x:ConnectionId='5'
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                                  />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Active profile  -->
                <Border
                    Grid.Row="4"
                    Padding="16,10"
                    Background="#FF0A0A14"
                    BorderBrush="{StaticResource DarkBg3Brush}"
                    BorderThickness="0,1,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock
                            CharacterSpacing="200"
                            FontSize="9"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="ACTIVE PROFILE" />
                        <TextBlock x:ConnectionId='3'
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NeonPurpleBrush}"
                                                                                                                    
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  ??????? CONTENT FRAME ???????  -->
        <Frame x:ConnectionId='2' x:Name="ContentFrame" Grid.Column="1" />
    </Grid>
</Page>

