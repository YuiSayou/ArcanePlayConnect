<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.FollowerDatabasePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Grid Padding="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ??? HEADER ??? -->
        <StackPanel Grid.Row="0" Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                          Foreground="#FFB400FF" />
                <TextBlock Text="FOLLOWER DATABASE" FontSize="18" FontWeight="Bold"
                           Foreground="#FFB400FF" CharacterSpacing="100" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Viewers who follow are stored here. When a known follower joins your live, their Join event is automatically upgraded to a Follow action."
                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,2,0,0" />
            <Border Height="2" CornerRadius="1" Margin="0,8,0,0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFB400FF" Offset="0" />
                        <GradientStop Color="#FFFF3278" Offset="0.5" />
                        <GradientStop Color="#FF00C8FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </StackPanel>

        <!-- ??? STATS + ACTIONS BAR ??? -->
        <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Follower count -->
            <Border Grid.Column="0" Background="#FF12121E" CornerRadius="6" Padding="14,8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="FOLLOWERS" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120"
                               VerticalAlignment="Center" />
                    <TextBlock x:ConnectionId='18' x:Name="FollowerCountText" Text="0" FontSize="20" FontWeight="Bold"
                               Foreground="#FFB400FF" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Search -->
            <TextBox x:ConnectionId='14' x:Name="SearchBox" Grid.Column="1" PlaceholderText="Search by username or nickname..."
                     Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" Padding="10,8"
                                                         />

            <!-- Add -->
            <Button x:ConnectionId='15' Grid.Column="2"                          
                    Padding="14,8" CornerRadius="4" FontSize="11" FontWeight="Bold"
                    Foreground="White" BorderThickness="0">
                <Button.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFB400FF" Offset="0" />
                        <GradientStop Color="#FF00C8FF" Offset="1" />
                    </LinearGradientBrush>
                </Button.Background>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    <TextBlock Text="Add Follower" />
                </StackPanel>
            </Button>

            <!-- Delete All -->
            <Button x:ConnectionId='16' Grid.Column="3"                        
                    Background="#FF1E1E36" Foreground="#FFFF3278"
                    BorderBrush="#FFFF3278" BorderThickness="1"
                    Padding="14,8" CornerRadius="4" FontSize="11" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Delete All" />
                </StackPanel>
            </Button>

            <!-- Refresh -->
            <Button x:ConnectionId='17' Grid.Column="4"                      
                    Background="#FF1E1E36" Foreground="{StaticResource TextSecondaryBrush}"
                    BorderBrush="#FF1A1A2E" BorderThickness="1"
                    Padding="14,8" CornerRadius="4" FontSize="11" FontWeight="SemiBold">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- ??? ADD/EDIT PANEL ??? -->
        <Border x:ConnectionId='2' x:Name="EditPanel" Grid.Row="2" Margin="0,12,0,0" Padding="16,14"
                Background="{StaticResource CardBgBrush}" BorderBrush="#FFB400FF" BorderThickness="1"
                CornerRadius="8" Visibility="Collapsed">
            <StackPanel Spacing="12">
                <TextBlock x:ConnectionId='8' x:Name="EditPanelTitle" Text="ADD FOLLOWER" FontSize="12" FontWeight="Bold"
                           Foreground="#FFB400FF" CharacterSpacing="100" />
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4">
                        <TextBlock Text="USERNAME" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                        <TextBox x:ConnectionId='13' x:Name="EditUsernameBox" PlaceholderText="tiktok_username"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" Padding="10,8" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="NICKNAME (DISPLAY NAME)" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                        <TextBox x:ConnectionId='12' x:Name="EditNicknameBox" PlaceholderText="Display Name"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" Padding="10,8" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Text="NOTES (OPTIONAL)" FontSize="9" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                    <TextBox x:ConnectionId='11' x:Name="EditNotesBox" PlaceholderText="Optional notes..."
                             Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" Padding="10,8" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:ConnectionId='9'                          Content="Cancel"
                            Background="{StaticResource CardBgBrush}"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            BorderBrush="{StaticResource TextSecondaryBrush}" BorderThickness="1"
                            Padding="16,8" CornerRadius="4" FontSize="11" FontWeight="SemiBold" />
                    <Button x:ConnectionId='10' x:Name="SaveEditBtn"                        Content="Save"
                            Padding="20,8" CornerRadius="4" FontSize="11" FontWeight="Bold"
                            Foreground="White" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FFB400FF" Offset="0" />
                                <GradientStop Color="#FF00C8FF" Offset="1" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ??? FOLLOWER LIST ??? -->
        <Border Grid.Row="3" Margin="0,12,0,0" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <!-- Empty state -->
                <StackPanel x:ConnectionId='3' x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8">
                    <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#FF1A1A2E" />
                    <TextBlock Text="No followers yet" FontSize="14" Foreground="#FF8888AA"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="Followers are automatically added when a viewer triggers a Follow event, or you can add them manually."
                               FontSize="11" Foreground="#FF555566" HorizontalAlignment="Center" TextWrapping="Wrap"
                               MaxWidth="400" TextAlignment="Center" />
                </StackPanel>

                <!-- List -->
                <ListView x:ConnectionId='4' x:Name="FollowerList" Background="Transparent" SelectionMode="None" Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,10" Background="#FF12121E" CornerRadius="6">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36"
                                            Background="#FF1A1A2E" CornerRadius="18"
                                            VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                  Foreground="#FFB400FF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <!-- Info -->
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Nickname}" FontSize="13" FontWeight="Bold"
                                                       Foreground="#FFE0E0FF" />
                                            <TextBlock FontSize="11" Foreground="#FF8888AA" VerticalAlignment="Center">
                                                <Run Text="@" /><Run Text="{Binding Username}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="12">
                                            <TextBlock FontSize="10" Foreground="#FF8888AA">
                                                <Run Text="Followed: " />
                                                <Run Text="{Binding FollowedAt}" Foreground="#FFB400FF" />
                                            </TextBlock>
                                            <TextBlock FontSize="10" Foreground="#FF555566"
                                                       Text="{Binding Notes}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="200" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Edit -->
                                    <Button x:ConnectionId='6' Grid.Column="2" Padding="8,6" Background="Transparent"
                                            BorderThickness="0"                            Tag="{Binding}"
                                            ToolTipService.ToolTip="Edit follower">
                                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                  Foreground="#FF00C8FF" />
                                    </Button>

                                    <!-- Delete -->
                                    <Button x:ConnectionId='7' Grid.Column="3" Padding="8,6" Background="Transparent"
                                            BorderThickness="0"                              Tag="{Binding}"
                                            ToolTipService.ToolTip="Remove follower">
                                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                  Foreground="#FFFF3278" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>

