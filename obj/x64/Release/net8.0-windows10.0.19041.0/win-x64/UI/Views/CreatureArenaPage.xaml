<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.CreatureArenaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT: Active Creatures ═══ -->
        <Grid Grid.Column="0" Padding="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                              Foreground="#FFFF3278" />
                    <TextBlock Text="CREATURE ARENA" FontSize="18" FontWeight="Bold"
                               Foreground="#FFFF3278" CharacterSpacing="100" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="Summoned creatures are tracked in real-time via entity tags. Configure the summon limit below."
                           FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                           Margin="0,2,0,0" />
                <Border Height="2" CornerRadius="1" Margin="0,8,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF3278" Offset="0" />
                            <GradientStop Color="#FFB400FF" Offset="0.5" />
                            <GradientStop Color="#FF00C8FF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>

            <!-- Stats bar -->
            <Grid Grid.Row="1" Margin="0,12,0,0" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="#FF12121E" CornerRadius="6" Padding="12,8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="ALIVE" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                        <TextBlock x:ConnectionId='23' x:Name="AliveCountText" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="#FF00FF88" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Background="#FF12121E" CornerRadius="6" Padding="12,8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="DEAD" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                        <TextBlock x:ConnectionId='22' x:Name="DeadCountText" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="#FFFF3278" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="#FF12121E" CornerRadius="6" Padding="12,8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TOTAL" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                        <TextBlock x:ConnectionId='21' x:Name="TotalCountText" Text="0" FontSize="22" FontWeight="Bold"
                                   Foreground="#FF00C8FF" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="3" Background="#FF12121E" CornerRadius="6" Padding="12,8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="TRACKING" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120" />
                        <TextBlock x:ConnectionId='20' x:Name="TrackingStatusText" Text="OFF" FontSize="22" FontWeight="Bold"
                                   Foreground="#FF8888AA" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Summon Limit Mode -->
            <Border Grid.Row="2" Background="#FF12121E" CornerRadius="6"
                    Padding="14,10" Margin="0,10,0,0">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE748;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="#FFB400FF" />
                        <StackPanel>
                            <TextBlock Text="Summon Limit" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#FFB400FF" />
                            <TextBlock x:ConnectionId='19' x:Name="SummonLimitDescription" Text="Each viewer can only have 1 active creature"
                                       FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <ComboBox x:ConnectionId='18' x:Name="SummonLimitCombo" Grid.Column="1"
                              HorizontalAlignment="Right" VerticalAlignment="Center"
                              FontSize="11" MinWidth="150"
                              Background="#FF0D0D1A"
                                                                                  >
                        <ComboBoxItem Content="One Per Player" Tag="OnePerPlayer" />
                        <ComboBoxItem Content="Unlimited" Tag="Unlimited" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- Auto-Respawn settings panel -->
            <Border x:ConnectionId='4' x:Name="AutoRespawnPanel" Grid.Row="3" Background="#FF12121E" CornerRadius="6"
                    Padding="14,10" Margin="0,10,0,0">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:ConnectionId='17' x:Name="AutoRespawnToggle" IsOn="False" MinWidth="0"
                                      OnContent="" OffContent=""
                                                                          />
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="#FF00C8FF" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Auto Respawn" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#FF00C8FF" />
                            <TextBlock Text="Automatically respawn dead creatures with their buff stats"
                                       FontSize="9" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:ConnectionId='13' x:Name="AutoRespawnOptions" Visibility="Collapsed" Spacing="8"
                                Margin="48,0,0,0">
                        <!-- Delay -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Delay:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                            <NumberBox x:ConnectionId='16' x:Name="RespawnDelayBox" Value="5" Minimum="1" Maximum="60"
                                       SpinButtonPlacementMode="Compact" FontSize="11" Width="90"
                                       Background="#FF0D0D1A"
                                                                                   />
                            <TextBlock Text="seconds" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Follower button picker -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                          Foreground="#FFFF9500" VerticalAlignment="Center" />
                                <TextBlock Text="FOLLOWER RESPAWN BUTTON" FontSize="9" FontWeight="Bold"
                                           Foreground="#FFFF9500" CharacterSpacing="100" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:ConnectionId='15' x:Name="FollowerButtonCombo" PlaceholderText="Select button for followers..."
                                      HorizontalAlignment="Stretch" FontSize="11"
                                      Background="#FF0D0D1A"
                                                                                              />
                        </StackPanel>

                        <!-- Non-follower button picker -->
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                          Foreground="#FF8888AA" VerticalAlignment="Center" />
                                <TextBlock Text="NON-FOLLOWER RESPAWN BUTTON" FontSize="9" FontWeight="Bold"
                                           Foreground="#FF8888AA" CharacterSpacing="100" VerticalAlignment="Center" />
                            </StackPanel>
                            <ComboBox x:ConnectionId='14' x:Name="NonFollowerButtonCombo" PlaceholderText="Select button for non-followers..."
                                      HorizontalAlignment="Stretch" FontSize="11"
                                      Background="#FF0D0D1A"
                                                                                                 />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Active creatures list -->
            <ListView x:ConnectionId='5' x:Name="ActiveCreaturesList" Grid.Row="4" Margin="0,12,0,0"
                      Background="Transparent" SelectionMode="None" Padding="0">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,2" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF12121E" CornerRadius="6" Padding="12,10">
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Rank circle -->
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Ellipse Width="36" Height="36" Fill="#FF1A1A2E" />
                                    <TextBlock Text="{Binding RankDisplay}" FontSize="16" FontWeight="Bold"
                                               Foreground="#FF00C8FF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Info -->
                                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding OwnerNickname}" FontSize="13" FontWeight="Bold"
                                                   Foreground="#FFE0E0FF" />
                                        <Border CornerRadius="3" Padding="5,1" Background="#FF1A1A2E"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding EntityDisplayName}" FontSize="9"
                                                       Foreground="#FFB400FF" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- HP Bar -->
                                    <Grid Height="6" CornerRadius="3">
                                        <Border Background="#FF1A1A2E" CornerRadius="3" />
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding HpPercent}"
                                                     Height="6" CornerRadius="3"
                                                     Foreground="#FF00FF88" Background="Transparent" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="HP: " />
                                            <Run Text="{Binding HealthDisplay}" Foreground="#FF00FF88" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="DMG: " />
                                            <Run Text="{Binding DamageDealt}" Foreground="#FFFF9500" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="KILLS: " />
                                            <Run Text="{Binding KillCount}" Foreground="#FFFF3278" />
                                        </TextBlock>
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run Text="TIME: " />
                                            <Run Text="{Binding SurvivalTimeDisplay}" Foreground="#FF8888AA" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Alive badge -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,4"
                                        VerticalAlignment="Center"
                                        Background="#FF0D1F0D">
                                    <TextBlock Text="ALIVE" FontSize="9" FontWeight="Bold"
                                               Foreground="#FF00FF88" CharacterSpacing="100" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- Empty state -->
            <StackPanel x:ConnectionId='6' x:Name="EmptyState" Grid.Row="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="40" Foreground="#FF1A1A2E" />
                <TextBlock Text="No active creatures" FontSize="14" Foreground="#FF8888AA"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Creatures will appear here when viewers trigger summon actions"
                           FontSize="11" Foreground="#FF555566" HorizontalAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Controls bar -->
            <Grid Grid.Row="5" Margin="0,12,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:ConnectionId='7' x:Name="ToggleTrackingBtn" Grid.Column="0"                             
                        Padding="14,8" CornerRadius="4" FontSize="11" FontWeight="Bold"
                        Foreground="White" BorderThickness="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF00C8FF" Offset="0" />
                            <GradientStop Color="#FFB400FF" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:ConnectionId='10' x:Name="ToggleTrackingIcon" Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                        <TextBlock x:ConnectionId='11' x:Name="ToggleTrackingText" Text="Start Tracking" />
                    </StackPanel>
                </Button>

                <Button x:ConnectionId='8' Grid.Column="1"                      
                        Background="#FF1E1E36" Foreground="#FFFF3278"
                        BorderBrush="#FFFF3278" BorderThickness="1"
                        Padding="14,8" CornerRadius="4" FontSize="11" FontWeight="SemiBold"
                        ToolTipService.ToolTip="Runs: kill @e[type=!minecraft:player]">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Kill All Mobs" />
                    </StackPanel>
                </Button>

                <Button x:ConnectionId='9' Grid.Column="3"                           
                        Background="#FF1E1E36" Foreground="{StaticResource TextSecondaryBrush}"
                        BorderBrush="#FF1A1A2E" BorderThickness="1"
                        Padding="14,8" CornerRadius="4" FontSize="11" FontWeight="SemiBold">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Reset Session" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1" Background="#FF1A1A2E" />

        <!-- ═══ RIGHT: Leaderboard ═══ -->
        <Grid Grid.Column="2" Background="#FF0D0D1A" Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Leaderboard header -->
            <Border Grid.Row="0" Padding="16,16,16,12"
                    BorderBrush="#FF1A1A2E" BorderThickness="0,0,0,1">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                  Foreground="#FFFF9500" />
                        <TextBlock Text="LEADERBOARD" FontSize="12" FontWeight="Bold"
                                   Foreground="#FFFF9500" CharacterSpacing="120" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Ranked by damage dealt &amp; survival" FontSize="9"
                               Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Leaderboard list -->
            <ListView x:ConnectionId='2' x:Name="LeaderboardList" Grid.Row="1"
                      Background="Transparent" SelectionMode="None"
                      Padding="8,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="MinHeight" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,7" CornerRadius="4"
                                Background="{Binding RowBackground}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Rank -->
                                <TextBlock Grid.Column="0" Text="{Binding RankDisplay}" FontSize="14" FontWeight="Bold"
                                           Foreground="{Binding RankColor}" VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Name + entity + status -->
                                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding OwnerNickname}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding NameColor}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding StatusEmoji}" FontSize="10" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding CreatureCountDisplay}" FontSize="9" FontWeight="Bold"
                                                   Foreground="#FFB400FF" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{Binding EntityDisplayName}" FontSize="9"
                                                   Foreground="#FF8888AA" />
                                        <TextBlock Text="{Binding SurvivalTimeDisplay}" FontSize="9"
                                                   Foreground="#FF8888AA" />
                                        <TextBlock Text="{Binding KilledByDisplay}" FontSize="9"
                                                   Foreground="#FFFF3278" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Score -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                            Spacing="0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding DamageDealt}" FontSize="14" FontWeight="Bold"
                                                   Foreground="#FFFF9500" />
                                        <TextBlock Text="{Binding KillCount}" FontSize="14" FontWeight="Bold"
                                                   Foreground="#FFFF3278" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="DMG" FontSize="7" FontWeight="Bold"
                                                   Foreground="#FF8888AA" CharacterSpacing="100" />
                                        <TextBlock Text="KILLS" FontSize="7" FontWeight="Bold"
                                                   Foreground="#FF8888AA" CharacterSpacing="100" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>

