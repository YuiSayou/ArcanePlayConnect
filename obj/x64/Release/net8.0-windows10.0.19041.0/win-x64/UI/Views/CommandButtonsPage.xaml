<?xml version="1.0" encoding="utf-8" ?>
<Page x:ConnectionId='1'
    x:Class="ArcanePlayConnect.UI.Views.CommandButtonsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ArcanePlayConnect.UI.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ArcanePlayConnect.Core.Models"
    Background="{StaticResource DarkBgBrush}"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Header  -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock
                    CharacterSpacing="100"
                    FontSize="22"
                    FontWeight="Bold"
                    Foreground="#FFFF9500"
                    Text="ACTIONS" />
                <TextBlock
                    FontSize="13"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="Create reusable multi-command actions — general or Minecraft-specific" />
            </StackPanel>
            <Button x:ConnectionId='25'
                Grid.Column="1"
                Padding="16,8"
                VerticalAlignment="Top"
                                          
                FontSize="12"
                Style="{StaticResource CyberpunkAccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="12"
                        Glyph="&#xE710;" />
                    <TextBlock Text="New Action" />
                </StackPanel>
            </Button>
        </Grid>

        <!--  Button grid  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsRepeater x:ConnectionId='2' x:Name="ButtonsRepeater"                                                             >
                <ItemsRepeater.Layout>
                    <UniformGridLayout
                        ItemsStretch="Fill"
                        MinColumnSpacing="12"
                        MinItemHeight="160"
                        MinItemWidth="320"
                        MinRowSpacing="12" />
                </ItemsRepeater.Layout>
                <ItemsRepeater.ItemTemplate>
                    <DataTemplate                                  >
                        <Border x:ConnectionId='4'
                            Padding="16,14"
                            Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource DarkBg3Brush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid RowSpacing="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!--  Top row: icon + name + actions  -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Type icon  -->
                                    <Border
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        Padding="6,4"
                                        VerticalAlignment="Center"
                                        CornerRadius="4">
                                        <Border.Background>
                                            <SolidColorBrush Opacity="0.15" Color="#FFFF9500" />
                                        </Border.Background>
                                        <FontIcon x:ConnectionId='24'
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="14"
                                            Foreground="#FFFF9500"
                                                                                                               />
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:ConnectionId='21'
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                                
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                            <Run x:ConnectionId='22'                                                                   />
                                            <Run Text=" - " />
                                            <Run x:ConnectionId='23'                                />
                                            <Run Text=" cmds" />
                                        </TextBlock>
                                    </StackPanel>

                                    <!--  Edit  -->
                                    <Button x:ConnectionId='19'
                                        Grid.Column="2"
                                        Padding="6,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                                                
                                                      
                                        ToolTipService.ToolTip="Edit button">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="{StaticResource NeonBlueBrush}"
                                            Glyph="&#xE70F;" />
                                    </Button>

                                    <!--  Delete  -->
                                    <Button x:ConnectionId='20'
                                        Grid.Column="3"
                                        Padding="6,4"
                                        Background="Transparent"
                                        BorderThickness="0"
                                                                  
                                                      
                                        ToolTipService.ToolTip="Delete button">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="{StaticResource NeonPinkBrush}"
                                            Glyph="&#xE74D;" />
                                    </Button>
                                </Grid>

                                <!--  Options tags  -->
                                <StackPanel
                                    Grid.Row="1"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <Border x:ConnectionId='9'
                                        Padding="6,2"
                                        Background="#FF0D1F0D"
                                        CornerRadius="3"
                                                                                                           >
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#FF00FF88"
                                            Text="TikTok Name" />
                                    </Border>
                                    <Border x:ConnectionId='10'
                                        Padding="6,2"
                                        Background="#FF1F0D1A"
                                        CornerRadius="3"
                                                                                                                   >
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#FFFF3278"
                                            Text="Tracked" />
                                    </Border>
                                    <Border x:ConnectionId='11'
                                        Padding="6,2"
                                        Background="#FF0D1F0D"
                                        CornerRadius="3"
                                                                                                             >
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#FF00FF88"
                                            Text="Heal" />
                                    </Border>
                                    <Border x:ConnectionId='12'
                                        Padding="6,2"
                                        Background="#FF1F0D0D"
                                        CornerRadius="3"
                                                                                                               >
                                        <TextBlock
                                            FontSize="9"
                                            Foreground="#FFFF3278"
                                            Text="DMG Buff" />
                                    </Border>
                                    <Border x:ConnectionId='13'
                                        Padding="6,2"
                                        Background="#FF1F0D1F"
                                        CornerRadius="3"
                                                                                                               >
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock
                                                FontSize="9"
                                                Foreground="#FFB400FF"
                                                Text="Continuous" />
                                            <TextBlock FontSize="9" Foreground="#FF8888AA">
                                                <Run Text="(" /><Run x:ConnectionId='18'                                 /><Run Text="s)" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                    <Border x:ConnectionId='14'
                                        Padding="6,2"
                                        Background="#FF1A1A2E"
                                        CornerRadius="3"
                                                                                                                        >
                                        <TextBlock x:ConnectionId='17'
                                            FontFamily="Consolas"
                                            FontSize="9"
                                            Foreground="#FF00C8FF"
                                                                             />
                                    </Border>
                                    <Border x:ConnectionId='15'
                                        Padding="6,2"
                                        Background="#FF1A1A0D"
                                        CornerRadius="3"
                                                                                                                    >
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <FontIcon
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="8"
                                                Foreground="#FFFF9500"
                                                Glyph="&#xE765;" />
                                            <TextBlock x:ConnectionId='16'
                                                FontFamily="Consolas"
                                                FontSize="9"
                                                Foreground="#FFFF9500"
                                                                                 />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!--  Command preview  -->
                                <Border
                                    Grid.Row="2"
                                    Padding="8,6"
                                    Background="{StaticResource DarkBg2Brush}"
                                    CornerRadius="4">
                                    <ItemsRepeater x:ConnectionId='6'                                >
                                        <ItemsRepeater.Layout>
                                            <StackLayout Spacing="2" />
                                        </ItemsRepeater.Layout>
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate                      >
                                                <TextBlock x:ConnectionId='8'
                                                    FontFamily="Consolas"
                                                    FontSize="10"
                                                    Foreground="{StaticResource NeonGreenBrush}"
                                                    Opacity="0.8"
                                                                   
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </Border>

                                <!--  Run button  -->
                                <Button x:ConnectionId='5'
                                    Grid.Row="3"
                                    Padding="0,8"
                                    HorizontalAlignment="Stretch"
                                                           
                                    CornerRadius="4"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                                  >
                                    <Button.Background>
                                        <SolidColorBrush Opacity="0.15" Color="#FFFF9500" />
                                    </Button.Background>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Foreground="#FFFF9500"
                                            Glyph="&#xE768;" />
                                        <TextBlock Foreground="#FFFF9500" Text="Execute" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsRepeater.ItemTemplate>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>

