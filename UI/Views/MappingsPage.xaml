<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.MappingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArcanePlayConnect.UI.Controls"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ArcanePlayConnect.Core.Models"
    xmlns:vm="using:ArcanePlayConnect.UI.ViewModels"
    x:Name="PageRoot"
    Background="{StaticResource DarkBgBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:ActionTypeToBrushConverter x:Key="ActionTypeToBrush" />
    </Page.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="900" Spacing="20">

            <!--  ═══ HEADER ═══  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        CharacterSpacing="100"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonPurpleBrush}"
                        Text="TRIGGERS" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Connect TikTok events to commands or actions — when viewers interact, your server reacts!"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    x:Name="AddMappingHeaderBtn"
                    Grid.Column="1"
                    Padding="16,10"
                    VerticalAlignment="Top"
                    Click="ToggleForm_Click"
                    FontSize="12"
                    Style="{StaticResource CyberpunkAccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="14"
                            Glyph="&#xE710;" />
                        <TextBlock Text="New Trigger" />
                    </StackPanel>
                </Button>
            </Grid>

            <!--  ═══ ACTIVE MAPPINGS LIST ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{StaticResource NeonPurpleBrush}"
                                Glyph="&#xE8A9;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="100"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="YOUR TRIGGERS" />
                            <Border
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="#33B400FF"
                                CornerRadius="10">
                                <TextBlock
                                    x:Name="MappingCountText"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{StaticResource NeonPurpleBrush}"
                                    Text="0" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!--  Empty state  -->
                    <Border
                        x:Name="EmptyState"
                        Padding="32,24"
                        Background="{StaticResource DarkBg2Brush}"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon
                                HorizontalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="32"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Glyph="&#xE71B;"
                                Opacity="0.5" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="No triggers yet" />
                            <TextBlock
                                MaxWidth="360"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Opacity="0.6"
                                Text="Click &quot;New Trigger&quot; above to connect a TikTok event to a command or action"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Mapping items  -->
                    <ListView
                        x:Name="MappingsList"
                        Background="Transparent"
                        ItemsSource="{x:Bind ViewModel.CurrentMappings, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ActionMappingItem">
                                <Border
                                    Padding="14,12"
                                    Background="{StaticResource CardBgBrush}"
                                    BorderBrush="{StaticResource DarkBg3Brush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Trigger side  -->
                                        <Border
                                            Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            VerticalAlignment="Center"
                                            Background="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                            CornerRadius="8"
                                            Opacity="0.15">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                                Text="{x:Bind TriggerTypeLabel}" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                CharacterSpacing="80"
                                                FontSize="10"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Text="{x:Bind TriggerTypeName}" />
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                                Text="{x:Bind TriggerDisplay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!--  Arrow  -->
                                        <Border
                                            Grid.Column="2"
                                            Width="28"
                                            Height="28"
                                            VerticalAlignment="Center"
                                            Background="#15FFFFFF"
                                            CornerRadius="14">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="10"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                Glyph="&#xE72A;" />
                                        </Border>

                                        <!--  Action side  -->
                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="9"
                                                    Foreground="{x:Bind ActionColor}"
                                                    Glyph="{x:Bind ActionGlyph}" />
                                                <TextBlock
                                                    CharacterSpacing="80"
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{x:Bind ActionTypeLabel}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{x:Bind ActionColor}"
                                                Opacity="0.9"
                                                Text="{x:Bind ActionDisplay}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <!--  Actions  -->
                                        <StackPanel
                                            Grid.Column="4"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="2">
                                            <Button
                                                Padding="8,6"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="TestMapping_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Test this mapping">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="13"
                                                    Foreground="{StaticResource NeonGreenBrush}"
                                                    Glyph="&#xE768;" />
                                            </Button>
                                            <Button
                                                Padding="8,6"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="RemoveMapping_Click"
                                                Tag="{x:Bind}"
                                                ToolTipService.ToolTip="Remove this mapping">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="13"
                                                    Foreground="{StaticResource NeonPinkBrush}"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!--  ═══ ADD MAPPING WIZARD ═══  -->
            <StackPanel
                x:Name="AddFormPanel"
                Spacing="16"
                Visibility="Collapsed">

                <!--  Wizard header  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="2">
                        <TextBlock
                            CharacterSpacing="80"
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="{StaticResource NeonBlueBrush}"
                            Text="CREATE NEW TRIGGER" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Follow the steps below to connect a TikTok event to an action" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Padding="8"
                        VerticalAlignment="Top"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CancelAdd_Click"
                        ToolTipService.ToolTip="Close">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="16"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <!--  ── STEP 1: TRIGGER ──  -->
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="26"
                                Height="26"
                                Background="{StaticResource NeonBlueBrush}"
                                CornerRadius="13">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="1" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="80"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="WHEN THIS HAPPENS..." />
                        </StackPanel>

                        <TextBlock
                            Margin="36,0,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Choose what TikTok event should trigger the action" />

                        <!--  Trigger type cards  -->
                        <Grid Margin="36,4,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                x:Name="GiftTypeBtn"
                                Grid.Column="0"
                                Padding="10,10"
                                Background="#FF1E1E36"
                                BorderBrush="#FFFF3278"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="TriggerType_PointerPressed"
                                Tag="Gift">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="#FFFF3278"
                                        Glyph="&#xE8E1;" />
                                    <TextBlock
                                        x:Name="GiftLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FFFF3278"
                                        Text="Gift" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Viewer sends gift"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="FollowTypeBtn"
                                Grid.Column="1"
                                Padding="10,10"
                                Background="#FF16162A"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="TriggerType_PointerPressed"
                                Tag="Follow">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="#FF8888AA"
                                        Glyph="&#xE77B;" />
                                    <TextBlock
                                        x:Name="FollowLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF8888AA"
                                        Text="Follow" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="New follower"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="ChatTypeBtn"
                                Grid.Column="2"
                                Padding="10,10"
                                Background="#FF16162A"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="TriggerType_PointerPressed"
                                Tag="Chat">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="#FF8888AA"
                                        Glyph="&#xE8BD;" />
                                    <TextBlock
                                        x:Name="ChatLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF8888AA"
                                        Text="Chat" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Chat message"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="LikeTypeBtn"
                                Grid.Column="3"
                                Padding="10,10"
                                Background="#FF16162A"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="TriggerType_PointerPressed"
                                Tag="Like">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="#FF8888AA"
                                        Glyph="&#xEB51;" />
                                    <TextBlock
                                        x:Name="LikeLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF8888AA"
                                        Text="Like" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Viewer likes"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="JoinTypeBtn"
                                Grid.Column="4"
                                Padding="10,10"
                                Background="#FF16162A"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="TriggerType_PointerPressed"
                                Tag="Join">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="20"
                                        Foreground="#FF8888AA"
                                        Glyph="&#xE72A;" />
                                    <TextBlock
                                        x:Name="JoinLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF8888AA"
                                        Text="Join" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Viewer joins live"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Follow-specific options -->
                        <Border
                            x:Name="FollowOptionsPanel"
                            Margin="36,8,0,0"
                            Padding="14,12"
                            Background="#FF12121E"
                            BorderBrush="#FFB400FF"
                            BorderThickness="1"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Foreground="#FFB400FF"
                                        Glyph="&#xE946;" />
                                    <TextBlock
                                        CharacterSpacing="100"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="#FFB400FF"
                                        Text="FOLLOW OPTIONS"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                                <CheckBox
                                    x:Name="ReplaceJoinMobCheck"
                                    Content="Replace existing Join mob (upgrade)"
                                    FontSize="12"
                                    Foreground="{StaticResource TextPrimaryBrush}" />
                                <TextBlock
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="When checked, if the viewer already has a mob from a Join event, it will be silently killed and replaced by this Follow action. The old mob's death/kills won't count in the rankings."
                                    TextWrapping="Wrap"
                                    Opacity="0.7" />
                            </StackPanel>
                        </Border>

                        <!--  Trigger key / filter  -->
                        <StackPanel
                            x:Name="TriggerKeyPanel"
                            Margin="36,4,0,0"
                            Spacing="8">
                            <TextBlock
                                x:Name="TriggerKeyLabel"
                                CharacterSpacing="120"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="GIFT NAME" />

                            <!--  Gift picker  -->
                            <StackPanel
                                x:Name="GiftPickerPanel"
                                Spacing="6"
                                Visibility="Collapsed">
                                <AutoSuggestBox
                                    x:Name="GiftSuggestBox"
                                    FontSize="12"
                                    GotFocus="GiftSuggestBox_GotFocus"
                                    PlaceholderText="Search gifts to add..."
                                    QuerySubmitted="GiftSuggestBox_QuerySubmitted"
                                    SuggestionChosen="GiftSuggestBox_SuggestionChosen"
                                    TextChanged="GiftSuggestBox_TextChanged"
                                    UpdateTextOnSelect="False">
                                    <AutoSuggestBox.QueryIcon>
                                        <SymbolIcon Symbol="Find" />
                                    </AutoSuggestBox.QueryIcon>
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:TikTokGift">
                                            <Grid Padding="4,4" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="32" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="32"
                                                    Height="32"
                                                    Background="#FF1A1A2E"
                                                    CornerRadius="4">
                                                    <Image
                                                        Width="28"
                                                        Height="28"
                                                        Source="{x:Bind DisplayImageUrl}"
                                                        Stretch="UniformToFill" />
                                                </Border>
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FFE0E0FF"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="#FFFF9500"
                                                    Text="{x:Bind DisplayText}" />
                                            </Grid>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>

                                <!--  Selected gifts chips  -->
                                <Border
                                    x:Name="SelectedGiftsBorder"
                                    MinHeight="36"
                                    Padding="8"
                                    Background="#FF12121E"
                                    BorderBrush="#FF1A1A2E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="SelectedGiftsCountText"
                                            Margin="0,0,0,4"
                                            FontSize="9"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="0 gifts selected" />
                                        <ItemsControl x:Name="SelectedGiftsList">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  Plain TextBox for non-gift types  -->
                            <TextBox
                                x:Name="TriggerKeyBox"
                                Padding="10,8"
                                FontSize="12"
                                PlaceholderText="e.g. Rose"
                                Style="{StaticResource CyberpunkTextBoxStyle}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ── STEP 2: ACTION ──  -->
                <Border Style="{StaticResource PanelBorderStyle}">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Border
                                Width="26"
                                Height="26"
                                Background="{StaticResource NeonPurpleBrush}"
                                CornerRadius="13">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="2" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="80"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="DO THIS..." />
                        </StackPanel>

                        <TextBlock
                            Margin="36,0,0,0"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Choose what happens when the event fires" />

                        <!--  Action mode toggle  -->
                        <Grid Margin="36,4,0,0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Name="ActionCommandBtn"
                                Grid.Column="0"
                                Padding="12,10"
                                Background="#FF1E1E36"
                                BorderBrush="#FF00FF88"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="ActionMode_PointerPressed"
                                Tag="Command">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="#FF00FF88"
                                        Glyph="&#xE756;" />
                                    <TextBlock
                                        x:Name="ActionCommandLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF00FF88"
                                        Text="RCON Command" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Run a server command"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="ActionButtonBtn"
                                Grid.Column="1"
                                Padding="12,10"
                                Background="#FF16162A"
                                BorderBrush="#FF1A1A2E"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="ActionMode_PointerPressed"
                                Tag="Button">
                                <StackPanel HorizontalAlignment="Center" Spacing="4">
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="18"
                                        Foreground="#FF8888AA"
                                        Glyph="&#xE946;" />
                                    <TextBlock
                                        x:Name="ActionButtonLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="#FF8888AA"
                                        Text="Trigger Action" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="Run a saved action"
                                        TextAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  COMMAND INPUT  -->
                        <StackPanel
                            x:Name="CommandPanel"
                            Margin="36,4,0,0"
                            Spacing="8">
                            <controls:CommandSuggestionBox
                                x:Name="CommandBox"
                                PlaceholderText="e.g. execute as {username} at @s run summon zombie ^ ^ ^2"
                                TextChanged="CommandBox_TextChanged" />

                            <Border
                                x:Name="CommandHintBorder"
                                Padding="10,6"
                                Background="#FF0D1F0D"
                                BorderBrush="#FF00FF88"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,1,0,0"
                                        VerticalAlignment="Top"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="#FF00FF88"
                                        Glyph="&#xE946;" />
                                    <TextBlock
                                        x:Name="CommandHintText"
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="#FF00FF88"
                                        Text="{}{nickname} = display name &#x0A;{username} = TikTok username"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!--  Quick pick from saved commands  -->
                            <StackPanel
                                x:Name="LibraryPanel"
                                Margin="0,4,0,0"
                                Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="{StaticResource NeonGreenBrush}"
                                        Glyph="&#xE8F1;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        CharacterSpacing="120"
                                        FontSize="10"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource NeonGreenBrush}"
                                        Text="SAVED COMMANDS" />
                                    <Button
                                        Grid.Column="2"
                                        Padding="4,2"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ToggleLibrary_Click">
                                        <FontIcon
                                            x:Name="LibraryToggleIcon"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Glyph="&#xE70D;" />
                                    </Button>
                                </Grid>
                                <Border
                                    x:Name="LibraryListBorder"
                                    MaxHeight="140"
                                    Padding="4"
                                    Background="#FF0D0D1A"
                                    BorderBrush="#FF1A1A2E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Visibility="Collapsed">
                                    <ListView
                                        x:Name="SavedCommandsList"
                                        MaxHeight="130"
                                        Background="Transparent"
                                        IsItemClickEnabled="True"
                                        ItemClick="SavedCommand_ItemClick"
                                        SelectionMode="Single">
                                        <ListView.ItemContainerStyle>
                                            <Style TargetType="ListViewItem">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="MinHeight" Value="0" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            </Style>
                                        </ListView.ItemContainerStyle>
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="models:SavedCommand">
                                                <Grid Padding="8,5" ColumnSpacing="6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel
                                                        Grid.Column="0"
                                                        VerticalAlignment="Center"
                                                        Spacing="1">
                                                        <TextBlock
                                                            FontSize="11"
                                                            FontWeight="SemiBold"
                                                            Foreground="#FFE0E0FF"
                                                            Text="{x:Bind Label}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="9"
                                                            Foreground="#FF8888AA"
                                                            Text="{x:Bind Command}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <Button
                                                        Grid.Column="1"
                                                        Padding="4,2"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Click="DeleteSavedCommand_Click"
                                                        Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        FontSize="10"
                                                        Foreground="#FF8888AA"
                                                        Tag="{x:Bind}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </Border>
                            </StackPanel>

                            <!--  Save command to library  -->
                            <Grid Margin="0,2,0,0" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="SaveLabelBox"
                                    Grid.Column="0"
                                    Padding="10,7"
                                    FontSize="11"
                                    PlaceholderText="Label to save command as..."
                                    Style="{StaticResource CyberpunkTextBoxStyle}" />
                                <Button
                                    Grid.Column="1"
                                    Padding="10,7"
                                    Background="#FF1E1E36"
                                    BorderBrush="#FF00FF88"
                                    BorderThickness="1"
                                    Click="SaveCommand_Click"
                                    CornerRadius="4"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#FF00FF88">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="10"
                                            Glyph="&#xE74E;" />
                                        <TextBlock Text="Save" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!--  BUTTON SELECTOR  -->
                        <StackPanel
                            x:Name="ButtonPanel"
                            Margin="36,4,0,0"
                            Spacing="8"
                            Visibility="Collapsed">
                            <TextBlock
                                CharacterSpacing="120"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="SELECT ACTION" />
                            <ComboBox
                                x:Name="ButtonCombo"
                                HorizontalAlignment="Stretch"
                                Background="#FF12121E"
                                FontSize="12"
                                PlaceholderText="Choose a command button..." />
                            <Border
                                Padding="10,6"
                                Background="#FF1F1A0D"
                                BorderBrush="#FFFF9500"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="#FFFF9500"
                                        Glyph="&#xE946;" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="10"
                                        Foreground="#FFFF9500"
                                        Text="Create actions in the Actions page first."
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  ── STEP 3: CONFIRM ──  -->
                <Border Padding="16,14" Style="{StaticResource PanelBorderStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <Border
                                Width="26"
                                Height="26"
                                Background="{StaticResource NeonGreenBrush}"
                                CornerRadius="13">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="White"
                                    Text="3" />
                            </Border>
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="80"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="ALL SET?" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" />

                        <Button
                            Grid.Column="2"
                            Padding="16,10"
                            Background="{StaticResource CardBgBrush}"
                            BorderBrush="{StaticResource TextSecondaryBrush}"
                            BorderThickness="1"
                            Click="CancelAdd_Click"
                            Content="Cancel"
                            CornerRadius="6"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextSecondaryBrush}" />

                        <Button
                            Grid.Column="3"
                            Padding="20,10"
                            BorderThickness="0"
                            Click="ConfirmAdd_Click"
                            CornerRadius="6"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="White">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Offset="0.0" Color="#FF00C8FF" />
                                    <GradientStop Offset="1.0" Color="#FFB400FF" />
                                </LinearGradientBrush>
                            </Button.Background>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="14"
                                    Glyph="&#xE73E;" />
                                <TextBlock Text="Add Trigger" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

            </StackPanel>

            <!--  ═══ QUICK REFERENCE ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{StaticResource NeonPurpleBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="QUICK REFERENCE" />
                    </StackPanel>
                    <Grid Margin="0,4,0,0" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="6">
                            <TextBlock
                                CharacterSpacing="100"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource NeonBlueBrush}"
                                Text="PLACEHOLDERS" />
                            <Border
                                Padding="10,8"
                                Background="{StaticResource DarkBg2Brush}"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NeonGreenBrush}"
                                            Text="{}{nickname}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="— viewer's display name" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock
                                            FontFamily="Consolas"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource NeonGreenBrush}"
                                            Text="{}{username}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            Text="— TikTok username" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="6">
                            <TextBlock
                                CharacterSpacing="100"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource NeonBlueBrush}"
                                Text="EXAMPLE COMMANDS" />
                            <Border
                                Padding="10,8"
                                Background="{StaticResource DarkBg2Brush}"
                                CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="say {nickname} sent a gift!"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        FontFamily="Consolas"
                                        FontSize="10"
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        Text="execute as {username} at @s run summon zombie ^ ^ ^2"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
