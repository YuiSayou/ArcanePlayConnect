<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.MappingsPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:ArcanePlayConnect.UI.ViewModels"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:ActionTypeToBrushConverter x:Key="ActionTypeToBrush" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="ACTION MAPPINGS" FontSize="22" FontWeight="Bold"
                       Foreground="{StaticResource NeonPurpleBrush}" CharacterSpacing="100" />
            <TextBlock Text="Map TikTok events to RCON commands"
                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>

        <!-- Mapping list -->
        <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="12">
            <ListView x:Name="MappingsList"
                      ItemsSource="{x:Bind ViewModel.CurrentMappings, Mode=OneWay}"
                      Background="Transparent" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionMappingItem">
                        <Grid Padding="8,10" ColumnSpacing="10" Margin="0,2"
                              Background="#FF1E1E36" CornerRadius="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Type icon -->
                            <Border Grid.Column="0" CornerRadius="4" Padding="6,4"
                                    VerticalAlignment="Center"
                                    Background="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                    Opacity="0.2">
                                <TextBlock Text="{x:Bind TriggerTypeLabel}" FontSize="14"
                                           FontFamily="Segoe MDL2 Assets"
                                           Foreground="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}" />
                            </Border>

                            <!-- Trigger display -->
                            <TextBlock Grid.Column="1" Text="{x:Bind TriggerDisplay}"
                                       Foreground="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                       FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                                       MinWidth="100" />

                            <!-- Arrow -->
                            <TextBlock Grid.Column="2" Text="&#x2192;" FontSize="12"
                                       Foreground="#FF8888AA" VerticalAlignment="Center" />

                            <!-- Action display: command or button -->
                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6"
                                        VerticalAlignment="Center">
                                <FontIcon Glyph="{x:Bind ActionGlyph}" FontFamily="Segoe MDL2 Assets"
                                          FontSize="11" Foreground="{x:Bind ActionColor}" />
                                <TextBlock Text="{x:Bind ActionDisplay}"
                                           Foreground="{x:Bind ActionColor}" FontSize="11"
                                           FontFamily="Consolas" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Opacity="0.85" />
                            </StackPanel>

                            <!-- Test -->
                            <Button Grid.Column="4" Click="TestMapping_Click" Tag="{x:Bind}"
                                    Background="Transparent" BorderThickness="0" Padding="6,4"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Test this mapping">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="{StaticResource NeonGreenBrush}" />
                            </Button>

                            <!-- Remove -->
                            <Button Grid.Column="5" Click="RemoveMapping_Click" Tag="{x:Bind}"
                                    Background="Transparent" BorderThickness="0" Padding="6,4"
                                    VerticalAlignment="Center"
                                    ToolTipService.ToolTip="Remove this mapping">
                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                          Foreground="{StaticResource NeonPinkBrush}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Add button -->
        <Button Grid.Row="4" Click="AddMapping_Click"
                Style="{StaticResource CyberpunkAccentButtonStyle}"
                HorizontalAlignment="Stretch" Padding="0,12" FontSize="13">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                <TextBlock Text="Add Action Mapping" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
