<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.ButtonEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:ArcanePlayConnect.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0A0A14">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,20,24,28" Spacing="14" MaxWidth="580">

            <!-- Header -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                              Foreground="#FFFF9500" VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderText" Text="CREATE COMMAND BUTTON" FontSize="15" FontWeight="Bold"
                               Foreground="#FFFF9500" CharacterSpacing="100" VerticalAlignment="Center" />
                </StackPanel>
                <Border Height="2" CornerRadius="1" Margin="0,6,0,0">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF9500" Offset="0" />
                            <GradientStop Color="#FFFF3278" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
            </StackPanel>

            <!-- Button Name -->
            <StackPanel Spacing="5">
                <TextBlock Text="BUTTON NAME" FontSize="10" FontWeight="Bold"
                           Foreground="#FF8888AA" CharacterSpacing="120" />
                <TextBox x:Name="NameBox" PlaceholderText="e.g. Spawn Zombie Army"
                         Background="#FF12121E" Foreground="#FFE0E0FF"
                         BorderBrush="#FF1A1A2E" BorderThickness="1"
                         Padding="10,8" CornerRadius="4" FontSize="13" />
            </StackPanel>

            <!-- Button Type -->
            <StackPanel Spacing="5">
                <TextBlock Text="BUTTON TYPE" FontSize="10" FontWeight="Bold"
                           Foreground="#FF8888AA" CharacterSpacing="120" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SummonTypeBtn" Grid.Column="0" CornerRadius="6" Padding="12,10"
                            Background="#FF1E1E36" BorderThickness="2" BorderBrush="#FFFF9500"
                            PointerPressed="TypeBtn_PointerPressed" Tag="Summon">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon x:Name="SummonIcon" Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="20" HorizontalAlignment="Center" Foreground="#FFFF9500" />
                            <TextBlock x:Name="SummonLabel" Text="SUMMON" FontSize="10" FontWeight="Bold"
                                       Foreground="#FFFF9500" HorizontalAlignment="Center" CharacterSpacing="100" />
                            <TextBlock Text="Spawn entities on events" FontSize="9"
                                       Foreground="#FF8888AA" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="HealthCheckTypeBtn" Grid.Column="1" CornerRadius="6" Padding="12,10"
                            Background="#FF16162A" BorderThickness="2" BorderBrush="#FF1A1A2E"
                            PointerPressed="TypeBtn_PointerPressed" Tag="HealthCheck">
                        <StackPanel Spacing="4" HorizontalAlignment="Center">
                            <FontIcon x:Name="HealthIcon" Glyph="&#xE95E;" FontFamily="Segoe MDL2 Assets"
                                      FontSize="20" HorizontalAlignment="Center" Foreground="#FF8888AA" />
                            <TextBlock x:Name="HealthLabel" Text="HEALTH CHECK" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF8888AA" HorizontalAlignment="Center" CharacterSpacing="100" />
                            <TextBlock Text="Monitor or maintain server" FontSize="9"
                                       Foreground="#FF8888AA" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <!-- ═══ SUMMON BUILDER (only visible for Summon type) ═══ -->
            <Border x:Name="SummonBuilderPanel" Background="#FF12121E" CornerRadius="6" Padding="14,12">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xEA18;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FFFF3278" />
                        <TextBlock Text="SUMMON SETTINGS" FontSize="10" FontWeight="Bold"
                                   Foreground="#FFFF3278" CharacterSpacing="120" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Entity Type Picker -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="CREATURE TYPE" FontSize="9" FontWeight="Bold"
                                   Foreground="#FF8888AA" CharacterSpacing="100" />
                        <AutoSuggestBox x:Name="EntityTypeBox"
                                        PlaceholderText="Search entity (e.g. zombie, skeleton)..."
                                        Background="#FF0D0D1A" Foreground="#FF00FF88"
                                        FontSize="12" FontFamily="Consolas"
                                        QueryIcon="Find"
                                        TextChanged="EntityTypeBox_TextChanged"
                                        SuggestionChosen="EntityTypeBox_SuggestionChosen" />
                    </StackPanel>

                    <!-- Position -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="SPAWN POSITION" FontSize="9" FontWeight="Bold"
                                   Foreground="#FF8888AA" CharacterSpacing="100" />
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PositionBox" Text="~ ~ ~"
                                     Background="#FF0D0D1A" Foreground="#FF00C8FF"
                                     BorderBrush="#FF1A1A2E" BorderThickness="1"
                                     Padding="10,7" CornerRadius="4" FontSize="12" FontFamily="Consolas" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Content="~ ~ ~" Click="PositionPreset_Click" Tag="~ ~ ~"
                                        Background="#FF1A1A2E" Foreground="#FF00C8FF"
                                        BorderThickness="0" Padding="8,6" CornerRadius="3" FontSize="9" FontFamily="Consolas" />
                                <Button Content="~ ~1 ~" Click="PositionPreset_Click" Tag="~ ~1 ~"
                                        Background="#FF1A1A2E" Foreground="#FF00C8FF"
                                        BorderThickness="0" Padding="8,6" CornerRadius="3" FontSize="9" FontFamily="Consolas" />
                                <Button Content="~ ~2 ~" Click="PositionPreset_Click" Tag="~ ~2 ~"
                                        Background="#FF1A1A2E" Foreground="#FF00C8FF"
                                        BorderThickness="0" Padding="8,6" CornerRadius="3" FontSize="9" FontFamily="Consolas" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Custom HP -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="CUSTOM HP (0 = default)" FontSize="9" FontWeight="Bold"
                                       Foreground="#FF8888AA" CharacterSpacing="100" />
                            <NumberBox x:Name="CustomHealthBox" Value="0" Minimum="0" Maximum="2048"
                                       SpinButtonPlacementMode="Compact" FontSize="12"
                                       PlaceholderText="e.g. 100"
                                       Background="#FF0D0D1A" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="CUSTOM ATTACK (0 = default)" FontSize="9" FontWeight="Bold"
                                       Foreground="#FF8888AA" CharacterSpacing="100" />
                            <NumberBox x:Name="CustomAttackBox" Value="0" Minimum="0" Maximum="2048"
                                       SpinButtonPlacementMode="Compact" FontSize="12"
                                       PlaceholderText="e.g. 10"
                                       Background="#FF0D0D1A" />
                        </StackPanel>
                    </Grid>

                    <!-- HP/Attack presets -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="QUICK PRESETS" FontSize="9" FontWeight="Bold"
                                   Foreground="#FF8888AA" CharacterSpacing="100" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Weak (10 HP, 2 ATK)" Click="StatPreset_Click" Tag="10,2"
                                    Background="#FF1A1A2E" Foreground="#FF00FF88"
                                    BorderThickness="0" Padding="8,5" CornerRadius="3" FontSize="9" />
                            <Button Content="Normal (20 HP, 5 ATK)" Click="StatPreset_Click" Tag="20,5"
                                    Background="#FF1A1A2E" Foreground="#FFFF9500"
                                    BorderThickness="0" Padding="8,5" CornerRadius="3" FontSize="9" />
                            <Button Content="Boss (100 HP, 15 ATK)" Click="StatPreset_Click" Tag="100,15"
                                    Background="#FF1A1A2E" Foreground="#FFFF3278"
                                    BorderThickness="0" Padding="8,5" CornerRadius="3" FontSize="9" />
                            <Button Content="Tank (500 HP, 3 ATK)" Click="StatPreset_Click" Tag="500,3"
                                    Background="#FF1A1A2E" Foreground="#FFB400FF"
                                    BorderThickness="0" Padding="8,5" CornerRadius="3" FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Toggles -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="UseNicknameToggle" IsOn="True" MinWidth="0"
                                          OnContent="" OffContent="" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Use TikTok Name" FontSize="11" Foreground="#FFE0E0FF" />
                                <TextBlock Text="Name creature after viewer" FontSize="8" Foreground="#FF8888AA" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <ToggleSwitch x:Name="TrackCreatureToggle" IsOn="True" MinWidth="0"
                                          OnContent="" OffContent="" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Track in Arena" FontSize="11" Foreground="#FFE0E0FF" />
                                <TextBlock Text="Add viewer tag + tracking" FontSize="8" Foreground="#FF8888AA" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Boss toggle -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ToggleSwitch x:Name="BossToggle" IsOn="False" MinWidth="0"
                                      OnContent="" OffContent=""
                                      Toggled="BossToggle_Toggled" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Boss Creature" FontSize="11" Foreground="#FFFF3278" FontWeight="SemiBold" />
                            <TextBlock Text="Can be summoned infinitely (no one-per-viewer limit)" FontSize="8" Foreground="#FF8888AA" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Boss Name (only visible when Boss is toggled on) -->
                    <StackPanel x:Name="BossNamePanel" Spacing="4" Visibility="Collapsed">
                        <TextBlock Text="BOSS NAME" FontSize="9" FontWeight="Bold"
                                   Foreground="#FFFF3278" CharacterSpacing="100" />
                        <TextBox x:Name="BossNameBox" PlaceholderText="e.g. Dragon Lord, The Destroyer..."
                                 Background="#FF0D0D1A" Foreground="#FFFF3278"
                                 BorderBrush="#FF1A1A2E" BorderThickness="1"
                                 Padding="10,7" CornerRadius="4" FontSize="12" />
                        <TextBlock Text="This name will appear above the boss in-game instead of the viewer's TikTok name"
                                   FontSize="8" Foreground="#FF8888AA" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Summon Preview -->
                    <Border Background="#FF0D0D1A" CornerRadius="4" Padding="10,6"
                            BorderBrush="#FF1A1A2E" BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock Text="SUMMON PREVIEW" FontSize="8" FontWeight="Bold"
                                       Foreground="#FF8888AA" CharacterSpacing="120" />
                            <TextBlock x:Name="SummonPreviewText" FontSize="10" FontFamily="Consolas"
                                       Foreground="#FF00FF88" TextWrapping="Wrap"
                                       Text="summon minecraft:zombie ~ ~ ~" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ═══ HEALTH CHECK OPTIONS (only visible for HealthCheck type) ═══ -->
            <Border x:Name="HealthCheckPanel" Background="#FF12121E" CornerRadius="6" Padding="14,12"
                    Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="HEALTH CHECK OPTIONS" FontSize="10" FontWeight="Bold"
                               Foreground="#FF8888AA" CharacterSpacing="120" />

                    <StackPanel x:Name="ContinuousOption" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <ToggleSwitch x:Name="ContinuousToggle" IsOn="False" MinWidth="0"
                                          OnContent="" OffContent=""
                                          Toggled="ContinuousToggle_Toggled" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Run Continuously" FontSize="12"
                                           Foreground="#FFE0E0FF" />
                                <TextBlock Text="Repeat the command sequence at a set interval"
                                           FontSize="9" Foreground="#FF8888AA" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel x:Name="IntervalPanel" Visibility="Collapsed" Orientation="Horizontal" Spacing="8"
                                    Margin="48,0,0,0">
                            <TextBlock Text="Every" FontSize="12" Foreground="#FF8888AA" VerticalAlignment="Center" />
                            <NumberBox x:Name="IntervalBox" Value="30" Minimum="1" Maximum="3600"
                                       SpinButtonPlacementMode="Compact" FontSize="12" Width="100" />
                            <TextBlock Text="seconds" FontSize="12" Foreground="#FF8888AA" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Additional Commands list -->
            <StackPanel Spacing="5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CommandsLabel" Grid.Column="0" Text="ADDITIONAL COMMANDS (optional, run after summon)"
                               FontSize="10" FontWeight="Bold"
                               Foreground="#FF8888AA" CharacterSpacing="120" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="Drag to reorder" FontSize="9"
                               Foreground="#FF00FF88" VerticalAlignment="Center" />
                </Grid>

                <ListView x:Name="CommandsList" CanReorderItems="True" AllowDrop="True"
                          ReorderMode="Enabled"
                          Background="#FF12121E"
                          MinHeight="60" MaxHeight="160"
                          Padding="4"
                          CornerRadius="6">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,1" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid Background="#FF1E1E36" CornerRadius="4" Padding="10,8" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Grid.Column="0" Glyph="&#xE76F;" FontFamily="Segoe MDL2 Assets"
                                          FontSize="10" Foreground="#FF8888AA" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind}" FontSize="11" FontFamily="Consolas"
                                           Foreground="#FF00FF88" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="2" Click="RemoveCommand_Click" Tag="{x:Bind}"
                                        Background="Transparent" BorderThickness="0" Padding="4,2"
                                        VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                              Foreground="#FFFF3278" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- Add command row -->
                <Grid ColumnSpacing="8" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:CommandSuggestionBox x:Name="NewCommandBox" Grid.Column="0"
                             PlaceholderText="Enter RCON command... (use {tag} for creature's tag)" />
                    <Button Grid.Column="1" Click="AddCommand_Click"
                            Background="#FF1E1E36" Foreground="#FF00FF88"
                            BorderBrush="#FF00FF88" BorderThickness="1"
                            CornerRadius="4" FontWeight="SemiBold" FontSize="11" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                            <TextBlock Text="Add" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- {tag} hint for summon type -->
                <TextBlock x:Name="TagHint" FontSize="9" Foreground="#FF8888AA" TextWrapping="Wrap"
                           Text="💡 Use {tag} in commands to reference this creature's tracking tag. Example: effect give @e[tag={tag}] minecraft:speed 30" />
            </StackPanel>

            <!-- Action buttons -->
            <Grid ColumnSpacing="10" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Cancel" Click="Cancel_Click"
                        HorizontalAlignment="Stretch" Padding="0,10"
                        Background="#FF1E1E36" Foreground="#FFFF3278"
                        BorderBrush="#FFFF3278" BorderThickness="1"
                        CornerRadius="4" FontWeight="SemiBold" FontSize="13" />
                <Button Grid.Column="1" Click="Save_Click"
                        HorizontalAlignment="Stretch" Padding="0,10"
                        CornerRadius="4" FontWeight="Bold" FontSize="13"
                        Foreground="White" BorderThickness="0">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF9500" Offset="0" />
                            <GradientStop Color="#FFFF3278" Offset="1" />
                        </LinearGradientBrush>
                    </Button.Background>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                  Foreground="White" />
                        <TextBlock Text="Save Button" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
