<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.OverlaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:models="using:ArcanePlayConnect.Core.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" MaxWidth="800">

            <!-- ═══ HEADER ═══ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="OBS &amp; CLOUD OVERLAYS" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="100" />
                    <TextBlock Text="Create overlays for OBS Browser Source or TikTok Studio via Cloudflare Pages"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="ServerStatusDot" Width="8" Height="8" Fill="#FFFF3250"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="ServerStatusText" Text="Stopped" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ═══ SERVER CONTROL CARD ═══ -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource NeonGreenBrush}" />
                            <TextBlock Text="OVERLAY SERVER" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Port:" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="ServerPortBox" Grid.Column="1" Text="7700"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12"
                                 MaxLength="5" InputScope="Number" />
                        <Button x:Name="StartServerBtn" Grid.Column="2" Click="StartServer_Click"
                                Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Start Server" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopServerBtn" Grid.Column="3" Click="StopServer_Click"
                                Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" Padding="16,8"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- ═══ CLOUD RELAY SETTINGS ═══ -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                  Foreground="{StaticResource NeonPurpleBrush}" />
                        <TextBlock Text="CLOUD OVERLAY RELAY" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Ellipse x:Name="CloudRelayStatusDot" Width="8" Height="8" Fill="#FFFF3250"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="CloudRelayStatusText" Text="Stopped" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="Publishes overlay data to Cloudflare — no port forwarding needed. Overlays auto-connect to arcaneplayconnect.pages.dev"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="StartCloudRelayBtn" Click="StartCloudRelay_Click"
                                Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Start Cloud Relay" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopCloudRelayBtn" Click="StopCloudRelay_Click"
                                Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" Padding="16,8"
                                IsEnabled="False">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Opacity="0.7">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">How it works:</Run>
                        <Run> Your app pushes live data to Cloudflare. The overlay pages read it from the same site — no port forwarding or tunneling needed. Each overlay gets a unique cloud URL you can paste into TikTok Studio or OBS.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ═══ CREATE NEW OVERLAY ═══ -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon x:Name="CreateEditIcon" Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                  Foreground="{StaticResource NeonPurpleBrush}" />
                        <TextBlock x:Name="CreateEditTitle" Text="CREATE OVERLAY" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                        <Button x:Name="CancelEditBtn" Click="CancelEdit_Click"
                                Visibility="Collapsed"
                                Background="Transparent" BorderThickness="0" Padding="6,4"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                          Foreground="{StaticResource NeonPinkBrush}" />
                                <TextBlock Text="Cancel Edit" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{StaticResource NeonPinkBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Name -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="OverlayNameBox" Grid.Column="1" Text="My Overlay"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12"
                                 PlaceholderText="Overlay name..." />
                    </Grid>

                    <!-- ── LAYOUT PREVIEW PICKER ── -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="LAYOUT" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="150" />
                        <StackPanel x:Name="LayoutPicker" Orientation="Horizontal" Spacing="10">
                            <!-- Vertical -->
                            <Border x:Name="LayoutVertical" Tag="Vertical"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource NeonBlueBrush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <!-- Mini preview -->
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <!-- mini row 1 (gold) -->
                                        <Grid Height="20" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                    Background="#33FFD700" />
                                            <Ellipse Grid.Column="1" Width="14" Height="14" Fill="#33FFD700" />
                                            <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                    Background="#22FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                <Border Width="14" Height="8" CornerRadius="2" Background="#2200C8FF" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- mini row 2 (silver) -->
                                        <Grid Height="20" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                    Background="#33C0C0C0" />
                                            <Ellipse Grid.Column="1" Width="14" Height="14" Fill="#33C0C0C0" />
                                            <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                    Background="#15FFFFFF" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4">
                                                <Border Width="14" Height="8" CornerRadius="2" Background="#1500C8FF" />
                                            </StackPanel>
                                        </Grid>
                                        <!-- Label -->
                                        <TextBlock Text="Vertical Ranking" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Horizontal -->
                            <Border x:Name="LayoutHorizontal" Tag="Horizontal"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <!-- mini podium -->
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="3"
                                                        HorizontalAlignment="Center">
                                                <Ellipse Width="16" Height="16" Fill="#33C0C0C0"
                                                         HorizontalAlignment="Center" />
                                                <Border Height="3" Width="22" CornerRadius="2"
                                                        Background="#15FFFFFF" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="3"
                                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <Ellipse Width="20" Height="20" Fill="#33FFD700"
                                                         HorizontalAlignment="Center" />
                                                <Border Height="3" Width="26" CornerRadius="2"
                                                        Background="#22FFFFFF" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="3"
                                                        HorizontalAlignment="Center">
                                                <Ellipse Width="14" Height="14" Fill="#33CD7F32"
                                                         HorizontalAlignment="Center" />
                                                <Border Height="3" Width="20" CornerRadius="2"
                                                        Background="#10FFFFFF" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Horizontal Podium" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Gift Wall (Grid) -->
                            <Border x:Name="LayoutGiftWall" Tag="GiftWall"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border Grid.Column="0" Grid.Row="0" Width="18" Height="18"
                                                    CornerRadius="4" Background="#33FF3278" Margin="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎁" FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Grid.Row="0" Width="18" Height="18"
                                                    CornerRadius="4" Background="#33FF9500" Margin="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🌹" FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2" Grid.Row="0" Width="18" Height="18"
                                                    CornerRadius="4" Background="#3300C8FF" Margin="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="💎" FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="0" Grid.Row="1" Width="18" Height="18"
                                                    CornerRadius="4" Background="#33B400FF" Margin="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🦋" FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="1" Grid.Row="1" Width="18" Height="18"
                                                    CornerRadius="4" Background="#3300FF88" Margin="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🎮" FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <Border Grid.Column="2" Grid.Row="1" Width="18" Height="18"
                                                    CornerRadius="4" Background="#33FFD700" Margin="1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="🦁" FontSize="9" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="Gift Grid" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Gift Wall Vertical (List) -->
                            <Border x:Name="LayoutGiftWallVertical" Tag="GiftWallVertical"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <StackPanel Height="42" Spacing="3" Margin="4,0">
                                            <!-- mini gift row 1 -->
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                                        Background="#33FF3278">
                                                    <TextBlock Text="🎁" FontSize="8" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Border Grid.Column="1" Height="5" CornerRadius="2"
                                                        Background="#22FFFFFF" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Height="10" Width="28" CornerRadius="3"
                                                        Background="#15B400FF" />
                                            </Grid>
                                            <!-- mini gift row 2 -->
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="18" Height="18" CornerRadius="4"
                                                        Background="#33FF9500">
                                                    <TextBlock Text="🌹" FontSize="8" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <Border Grid.Column="1" Height="5" CornerRadius="2"
                                                        Background="#15FFFFFF" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Height="10" Width="28" CornerRadius="3"
                                                        Background="#15B400FF" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="Gift List" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!-- Second row of layout cards -->
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                            <!-- Likes Ranking Vertical -->
                            <Border x:Name="LayoutLikesVertical" Tag="LikesVertical"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <StackPanel Height="42" Spacing="3" Margin="4,0">
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                        Background="#33FFD700" />
                                                <Ellipse Grid.Column="1" Width="14" Height="14" Fill="#33FFD700" />
                                                <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                        Background="#22FFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="❤️" FontSize="8"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                        Background="#33C0C0C0" />
                                                <Ellipse Grid.Column="1" Width="14" Height="14" Fill="#33C0C0C0" />
                                                <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                        Background="#15FFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="❤️" FontSize="8"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="Likes Vertical" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Likes Ranking Horizontal -->
                            <Border x:Name="LayoutLikesHorizontal" Tag="LikesHorizontal"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="2"
                                                        HorizontalAlignment="Center">
                                                <Ellipse Width="16" Height="16" Fill="#33C0C0C0"
                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="❤️" FontSize="7" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2"
                                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <Ellipse Width="20" Height="20" Fill="#33FFD700"
                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="❤️" FontSize="8" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="2"
                                                        HorizontalAlignment="Center">
                                                <Ellipse Width="14" Height="14" Fill="#33CD7F32"
                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="❤️" FontSize="7" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Likes Horizontal" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Gift Ranking Vertical -->
                            <Border x:Name="LayoutGiftRankVertical" Tag="GiftRankVertical"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <StackPanel Height="42" Spacing="3" Margin="4,0">
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                        Background="#33FFD700" />
                                                <Ellipse Grid.Column="1" Width="14" Height="14" Fill="#33FFD700" />
                                                <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                        Background="#22FFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="🪙" FontSize="8"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Width="16" Height="16" CornerRadius="8"
                                                        Background="#33C0C0C0" />
                                                <Ellipse Grid.Column="1" Width="14" Height="14" Fill="#33C0C0C0" />
                                                <Border Grid.Column="2" Height="6" CornerRadius="3"
                                                        Background="#15FFFFFF" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="🪙" FontSize="8"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock Text="Gift Rank Vertical" FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Gift Ranking Horizontal -->
                            <Border x:Name="LayoutGiftRankHorizontal" Tag="GiftRankHorizontal"
                                    PointerPressed="LayoutCard_Click"
                                    Width="130" CornerRadius="8" Padding="0"
                                    BorderThickness="2" BorderBrush="{StaticResource DarkBg3Brush}"
                                    Background="{StaticResource CardBgBrush}">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Spacing="2"
                                                        HorizontalAlignment="Center">
                                                <Ellipse Width="16" Height="16" Fill="#33C0C0C0"
                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="🪙" FontSize="7" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2"
                                                        HorizontalAlignment="Center" Margin="0,0,0,6">
                                                <Ellipse Width="20" Height="20" Fill="#33FFD700"
                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="🪙" FontSize="8" HorizontalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Spacing="2"
                                                        HorizontalAlignment="Center">
                                                <Ellipse Width="14" Height="14" Fill="#33CD7F32"
                                                         HorizontalAlignment="Center" />
                                                <TextBlock Text="🪙" FontSize="7" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="Gift Rank Horiz." FontSize="9" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── THEME PREVIEW PICKER ── -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="THEME" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="150" />
                        <GridView x:Name="ThemePicker" SelectionMode="None"
                                  IsItemClickEnabled="True" ItemClick="ThemeCard_Click">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="3"
                                                   ItemWidth="166" ItemHeight="80" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </StackPanel>

                    <!-- Stats toggles -->
                    <Grid x:Name="RankingSettingsPanel" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Show" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
                            <CheckBox x:Name="ShowHPCheck" Content="HP" IsChecked="True" FontSize="12"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox x:Name="ShowDmgCheck" Content="DMG" IsChecked="True" FontSize="12"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                            <CheckBox x:Name="ShowKillsCheck" Content="KILLS" IsChecked="True" FontSize="12"
                                      Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Grid>

                    <!-- ── GIFT WALL PICKER (visible only when GiftWall selected) ── -->
                    <StackPanel x:Name="GiftWallPanel" Spacing="8" Visibility="Collapsed">
                        <TextBlock Text="SELECT GIFTS FOR OVERLAY" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="150" />

                        <!-- Search box for gifts -->
                        <AutoSuggestBox x:Name="OverlayGiftSearch"
                                        PlaceholderText="Search gifts to add..."
                                        FontSize="12"
                                        TextChanged="OverlayGiftSearch_TextChanged"
                                        SuggestionChosen="OverlayGiftSearch_SuggestionChosen"
                                        QuerySubmitted="OverlayGiftSearch_QuerySubmitted"
                                        GotFocus="OverlayGiftSearch_GotFocus"
                                        UpdateTextOnSelect="False">
                            <AutoSuggestBox.QueryIcon>
                                <SymbolIcon Symbol="Find" />
                            </AutoSuggestBox.QueryIcon>
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TikTokGift">
                                    <Grid Padding="4,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4"
                                                Background="#FF1A1A2E">
                                            <Image Source="{x:Bind DisplayImageUrl}" Stretch="UniformToFill"
                                                   Width="28" Height="28" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                   Foreground="#FFE0E0FF" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind DisplayText}" FontSize="11"
                                                       Foreground="#FFFF9500" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>

                        <!-- Selected gifts display -->
                        <Border CornerRadius="6" Background="{StaticResource DarkBg2Brush}"
                                BorderBrush="{StaticResource DarkBg3Brush}" BorderThickness="1"
                                Padding="8" MinHeight="60">
                            <StackPanel>
                                <TextBlock x:Name="SelectedGiftsCountText" Text="0 gifts selected"
                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6" />
                                <ItemsControl x:Name="SelectedGiftsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Gift text labels -->
                        <StackPanel x:Name="GiftTextLabelsPanel" Spacing="6" Visibility="Collapsed">
                            <TextBlock Text="GIFT TEXT LABELS (optional)" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource NeonPurpleBrush}" CharacterSpacing="120" />
                            <TextBlock Text="Add custom text to display beside each gift in the overlay"
                                       FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                            <StackPanel x:Name="GiftTextInputsList" Spacing="6" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Max Players & Refresh (plain TextBox) -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Players" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBox x:Name="MaxPlayersBox" Grid.Column="1" Text="5" Width="60"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12"
                                 MaxLength="2" InputScope="Number" TextAlignment="Center" />
                        <Border Grid.Column="2" />
                        <TextBlock Grid.Column="3" Text="Refresh" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6">
                            <TextBox x:Name="RefreshBox" Text="2000" Width="70"
                                     Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12"
                                     MaxLength="5" InputScope="Number" TextAlignment="Center" />
                            <TextBlock Text="ms" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Create button -->
                    <Button x:Name="CreateSaveBtn" Click="CreateOverlay_Click"
                            Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="20,10"
                            HorizontalAlignment="Left" Margin="0,2,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="CreateSaveBtnIcon" Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock x:Name="CreateSaveBtnText" Text="Create Overlay" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ═══ OVERLAY LIST ═══ -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8A9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                  Foreground="{StaticResource NeonBlueBrush}" />
                        <TextBlock Text="YOUR OVERLAYS" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="OverlayCountText" Text="(0)" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Empty state -->
                    <Border x:Name="OverlayEmptyState" Padding="20" CornerRadius="8"
                            Background="{StaticResource DarkBg2Brush}">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock Text="No overlays created yet" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Create one above to get started" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"
                                       Opacity="0.6" />
                        </StackPanel>
                    </Border>

                    <!-- Overlay items -->
                    <ListView x:Name="OverlayListView" SelectionMode="None"
                              IsItemClickEnabled="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBgBrush}" CornerRadius="8"
                                        BorderBrush="{StaticResource DarkBg3Brush}" BorderThickness="1"
                                        Padding="14,10">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="8"
                                                Background="{StaticResource DarkBg2Brush}"
                                                VerticalAlignment="Center">
                                            <FontIcon Glyph="{Binding LayoutGlyph}" FontFamily="Segoe MDL2 Assets"
                                                      FontSize="16" Foreground="{Binding ThemeAccentBrush}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding LayoutLabel}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="•" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding ThemeLabel}" FontSize="10"
                                                           Foreground="{Binding ThemeAccentBrush}" />
                                                <TextBlock Text="•" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding StatsLabel}" FontSize="10"
                                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Url}" FontSize="10"
                                                       Foreground="{StaticResource NeonGreenBrush}"
                                                       FontFamily="Consolas" Opacity="0.8"
                                                       IsTextSelectionEnabled="True"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CloudUrl}" FontSize="10"
                                                       Foreground="{StaticResource NeonPurpleBrush}"
                                                       FontFamily="Consolas" Opacity="0.8"
                                                       IsTextSelectionEnabled="True"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding HasCloudUrl}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <Button Click="CopyUrl_Click" Tag="{Binding Url}"
                                                    ToolTipService.ToolTip="Copy local URL"
                                                    Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="{StaticResource NeonBlueBrush}" />
                                            </Button>
                                            <Button Click="CopyUrl_Click" Tag="{Binding CloudUrl}"
                                                    ToolTipService.ToolTip="Copy cloud URL"
                                                    Background="Transparent" BorderThickness="0" Padding="8"
                                                    Visibility="{Binding HasCloudUrl}">
                                                <FontIcon Glyph="&#xE753;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="{StaticResource NeonPurpleBrush}" />
                                            </Button>
                                            <Button Click="PreviewOverlay_Click" Tag="{Binding Url}"
                                                    ToolTipService.ToolTip="Preview in browser"
                                                    Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="{StaticResource NeonGreenBrush}" />
                                            </Button>
                                            <Button Click="EditOverlay_Click" Tag="{Binding Id}"
                                                    ToolTipService.ToolTip="Edit overlay"
                                                    Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="{StaticResource NeonPurpleBrush}" />
                                            </Button>
                                            <Button Click="DeleteOverlay_Click" Tag="{Binding Id}"
                                                    ToolTipService.ToolTip="Delete overlay"
                                                    Background="Transparent" BorderThickness="0" Padding="8">
                                                <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                          FontSize="14" Foreground="{StaticResource NeonPinkBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!-- ═══ SETUP GUIDE ═══ -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                  Foreground="{StaticResource NeonPurpleBrush}" />
                        <TextBlock Text="SETUP GUIDE" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Text="CLOUD OVERLAY (TikTok Studio / Remote OBS)" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource NeonPurpleBrush}" CharacterSpacing="80" />
                    <StackPanel Spacing="6" Padding="4,0,0,0">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">1.</Run>
                            <Run> Create an overlay with your preferred theme and layout</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">2.</Run>
                            <Run> Click "Start Cloud Relay" — your data is pushed to Cloudflare automatically</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">3.</Run>
                            <Run> Copy the</Run>
                            <Run FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NeonPurpleBrush}">&#xE753;</Run>
                            <Run> cloud URL and paste it into TikTok Studio or OBS as a Browser Source</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">4.</Run>
                            <Run> No port forwarding needed — it just works!</Run>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="LOCAL OVERLAY (OBS on same PC)" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="80" Margin="0,8,0,0" />
                    <StackPanel Spacing="6" Padding="4,0,0,0">
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">1.</Run>
                            <Run> Start the Overlay Server above</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">2.</Run>
                            <Run> Create an overlay with your preferred theme and layout</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">3.</Run>
                            <Run> Click the</Run>
                            <Run FontFamily="Segoe MDL2 Assets">&#xE8C8;</Run>
                            <Run> copy button to copy the local URL</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">4.</Run>
                            <Run> In OBS: Sources → Add → Browser Source → paste URL</Run>
                        </TextBlock>
                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">5.</Run>
                            <Run> Set width=</Run>
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonGreenBrush}">400</Run>
                            <Run> for vertical, or width=</Run>
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonGreenBrush}">800</Run>
                            <Run> for horizontal layout</Run>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" Margin="0,4,0,0">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">Tip:</Run>
                        <Run> You can create multiple overlays with different themes and layouts! Each gets its own unique cloud and local URL.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
