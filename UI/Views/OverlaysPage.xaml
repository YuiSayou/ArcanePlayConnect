<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.OverlaysPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ArcanePlayConnect.Core.Models"
    Background="{StaticResource DarkBgBrush}"
    mc:Ignorable="d">

    <Page.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <ScrollViewer Padding="24" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" Spacing="20">

            <!--  ═══ HEADER ═══  -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        CharacterSpacing="100"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonBlueBrush}"
                        Text="OBS &amp; CLOUD OVERLAYS" />
                    <TextBlock
                        FontSize="13"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Create overlays for OBS Browser Source or TikTok Studio via Cloudflare Pages" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Ellipse
                            x:Name="ServerStatusDot"
                            Width="8"
                            Height="8"
                            VerticalAlignment="Center"
                            Fill="#FFFF3250" />
                        <TextBlock
                            x:Name="ServerStatusText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="Stopped" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!--  ═══ SERVER CONTROL CARD ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Grid.Column="0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <FontIcon
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="18"
                                Foreground="{StaticResource NeonGreenBrush}"
                                Glyph="&#xE774;" />
                            <TextBlock
                                VerticalAlignment="Center"
                                CharacterSpacing="100"
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Text="LOCAL OVERLAY" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Port:" />
                        <TextBox
                            x:Name="ServerPortBox"
                            Grid.Column="1"
                            FontSize="12"
                            InputScope="Number"
                            MaxLength="5"
                            Style="{StaticResource CyberpunkTextBoxStyle}"
                            Text="7700" />
                        <Button
                            x:Name="StartServerBtn"
                            Grid.Column="2"
                            Padding="16,8"
                            Click="StartServer_Click"
                            FontSize="12"
                            Style="{StaticResource CyberpunkAccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="&#xE768;" />
                                <TextBlock Text="Start Server" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="StopServerBtn"
                            Grid.Column="3"
                            Padding="16,8"
                            Click="StopServer_Click"
                            FontSize="12"
                            IsEnabled="False"
                            Style="{StaticResource CyberpunkDangerButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="&#xE71A;" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!--  ═══ CLOUD RELAY SETTINGS ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{StaticResource NeonPurpleBrush}"
                            Glyph="&#xE753;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="CLOUD OVERLAY" />
                        <StackPanel
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Ellipse
                                x:Name="CloudRelayStatusDot"
                                Width="8"
                                Height="8"
                                VerticalAlignment="Center"
                                Fill="#FFFF3250" />
                            <TextBlock
                                x:Name="CloudRelayStatusText"
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Stopped" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock
                        FontSize="11"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="Publishes overlay data to Cloudflare — no port forwarding needed. Overlays auto-connect to arcaneplayconnect.pages.dev"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button
                            x:Name="StartCloudRelayBtn"
                            Padding="16,8"
                            Click="StartCloudRelay_Click"
                            FontSize="12"
                            Style="{StaticResource CyberpunkAccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="&#xE753;" />
                                <TextBlock Text="Start Cloud Overlay" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="StopCloudRelayBtn"
                            Padding="16,8"
                            Click="StopCloudRelay_Click"
                            FontSize="12"
                            IsEnabled="False"
                            Style="{StaticResource CyberpunkDangerButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="12"
                                    Glyph="&#xE71A;" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock
                        FontSize="10"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Opacity="0.7"
                        TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">How it works:</Run>
                        <Run>Your app pushes live data to Cloudflare. The overlay pages read it from the same site — no port forwarding or tunneling needed. Each overlay gets a unique cloud URL you can paste into TikTok Studio or OBS.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!--  ═══ CREATE NEW OVERLAY ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            x:Name="CreateEditIcon"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{StaticResource NeonPurpleBrush}"
                            Glyph="&#xE710;" />
                        <TextBlock
                            x:Name="CreateEditTitle"
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="CREATE OVERLAY" />
                        <Button
                            x:Name="CancelEditBtn"
                            Padding="6,4"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="CancelEdit_Click"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="10"
                                    Foreground="{StaticResource NeonPinkBrush}"
                                    Glyph="&#xE711;" />
                                <TextBlock
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource NeonPinkBrush}"
                                    Text="Cancel Edit" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!--  Name  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Name" />
                        <TextBox
                            x:Name="OverlayNameBox"
                            Grid.Column="1"
                            FontSize="12"
                            PlaceholderText="Overlay name..."
                            Style="{StaticResource CyberpunkTextBoxStyle}"
                            Text="My Overlay" />
                    </Grid>

                    <!--  ── LAYOUT PREVIEW PICKER ──  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            CharacterSpacing="150"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="LAYOUT" />
                        <StackPanel
                            x:Name="LayoutPicker"
                            Orientation="Horizontal"
                            Spacing="10">
                            <!--  Vertical  -->
                            <Border
                                x:Name="LayoutVertical"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource NeonBlueBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="Vertical">
                                <Grid>
                                    <!--  Mini preview  -->
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <!--  mini row 1 (gold)  -->
                                        <Grid Height="20" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Background="#33FFD700"
                                                CornerRadius="8" />
                                            <Ellipse
                                                Grid.Column="1"
                                                Width="14"
                                                Height="14"
                                                Fill="#33FFD700" />
                                            <Border
                                                Grid.Column="2"
                                                Height="6"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="#22FFFFFF"
                                                CornerRadius="3" />
                                            <StackPanel
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Border
                                                    Width="14"
                                                    Height="8"
                                                    Background="#2200C8FF"
                                                    CornerRadius="2" />
                                            </StackPanel>
                                        </Grid>
                                        <!--  mini row 2 (silver)  -->
                                        <Grid Height="20" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Background="#33C0C0C0"
                                                CornerRadius="8" />
                                            <Ellipse
                                                Grid.Column="1"
                                                Width="14"
                                                Height="14"
                                                Fill="#33C0C0C0" />
                                            <Border
                                                Grid.Column="2"
                                                Height="6"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="#15FFFFFF"
                                                CornerRadius="3" />
                                            <StackPanel
                                                Grid.Column="3"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Border
                                                    Width="14"
                                                    Height="8"
                                                    Background="#1500C8FF"
                                                    CornerRadius="2" />
                                            </StackPanel>
                                        </Grid>
                                        <!--  Label  -->
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Vertical Ranking" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Horizontal  -->
                            <Border
                                x:Name="LayoutHorizontal"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="Horizontal">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <!--  mini podium  -->
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="3">
                                                <Ellipse
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33C0C0C0" />
                                                <Border
                                                    Width="22"
                                                    Height="3"
                                                    Background="#15FFFFFF"
                                                    CornerRadius="2" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="3">
                                                <Ellipse
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33FFD700" />
                                                <Border
                                                    Width="26"
                                                    Height="3"
                                                    Background="#22FFFFFF"
                                                    CornerRadius="2" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="3">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33CD7F32" />
                                                <Border
                                                    Width="20"
                                                    Height="3"
                                                    Background="#10FFFFFF"
                                                    CornerRadius="2" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Horizontal Podium" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Gift Wall (Grid)  -->
                            <Border
                                x:Name="LayoutGiftWall"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="GiftWall">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#33FF3278"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Text="🎁" />
                                            </Border>
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Width="18"
                                                Height="18"
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#33FF9500"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Text="🌹" />
                                            </Border>
                                            <Border
                                                Grid.Row="0"
                                                Grid.Column="2"
                                                Width="18"
                                                Height="18"
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#3300C8FF"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Text="💎" />
                                            </Border>
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#33B400FF"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Text="🦋" />
                                            </Border>
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Width="18"
                                                Height="18"
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#3300FF88"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Text="🎮" />
                                            </Border>
                                            <Border
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Width="18"
                                                Height="18"
                                                Margin="1"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Background="#33FFD700"
                                                CornerRadius="4">
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    FontSize="9"
                                                    Text="🦁" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Gift Grid" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Gift Wall Vertical (List)  -->
                            <Border
                                x:Name="LayoutGiftWallVertical"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="GiftWallVertical">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <StackPanel
                                            Height="42"
                                            Margin="4,0"
                                            Spacing="3">
                                            <!--  mini gift row 1  -->
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="18"
                                                    Height="18"
                                                    Background="#33FF3278"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="8"
                                                        Text="🎁" />
                                                </Border>
                                                <Border
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Background="#22FFFFFF"
                                                    CornerRadius="2" />
                                                <Border
                                                    Grid.Column="2"
                                                    Width="28"
                                                    Height="10"
                                                    Background="#15B400FF"
                                                    CornerRadius="3" />
                                            </Grid>
                                            <!--  mini gift row 2  -->
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="18" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="18"
                                                    Height="18"
                                                    Background="#33FF9500"
                                                    CornerRadius="4">
                                                    <TextBlock
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="8"
                                                        Text="🌹" />
                                                </Border>
                                                <Border
                                                    Grid.Column="1"
                                                    Height="5"
                                                    VerticalAlignment="Center"
                                                    Background="#15FFFFFF"
                                                    CornerRadius="2" />
                                                <Border
                                                    Grid.Column="2"
                                                    Width="28"
                                                    Height="10"
                                                    Background="#15B400FF"
                                                    CornerRadius="3" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Gift List" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>

                        <!--  Second row of layout cards  -->
                        <StackPanel
                            Margin="0,10,0,0"
                            Orientation="Horizontal"
                            Spacing="10">
                            <!--  Likes Ranking Vertical  -->
                            <Border
                                x:Name="LayoutLikesVertical"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="LikesVertical">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <StackPanel
                                            Height="42"
                                            Margin="4,0"
                                            Spacing="3">
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Background="#33FFD700"
                                                    CornerRadius="8" />
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="14"
                                                    Height="14"
                                                    Fill="#33FFD700" />
                                                <Border
                                                    Grid.Column="2"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Background="#22FFFFFF"
                                                    CornerRadius="3" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Text="❤️" />
                                            </Grid>
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Background="#33C0C0C0"
                                                    CornerRadius="8" />
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="14"
                                                    Height="14"
                                                    Fill="#33C0C0C0" />
                                                <Border
                                                    Grid.Column="2"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Background="#15FFFFFF"
                                                    CornerRadius="3" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Text="❤️" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Likes Vertical" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Likes Ranking Horizontal  -->
                            <Border
                                x:Name="LayoutLikesHorizontal"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="LikesHorizontal">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="2">
                                                <Ellipse
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33C0C0C0" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="7"
                                                    Text="❤️" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="2">
                                                <Ellipse
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33FFD700" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="8"
                                                    Text="❤️" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="2">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33CD7F32" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="7"
                                                    Text="❤️" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Likes Horizontal" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Gift Ranking Vertical  -->
                            <Border
                                x:Name="LayoutGiftRankVertical"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="GiftRankVertical">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <StackPanel
                                            Height="42"
                                            Margin="4,0"
                                            Spacing="3">
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Background="#33FFD700"
                                                    CornerRadius="8" />
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="14"
                                                    Height="14"
                                                    Fill="#33FFD700" />
                                                <Border
                                                    Grid.Column="2"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Background="#22FFFFFF"
                                                    CornerRadius="3" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Text="🪙" />
                                            </Grid>
                                            <Grid Height="18" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="16" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Background="#33C0C0C0"
                                                    CornerRadius="8" />
                                                <Ellipse
                                                    Grid.Column="1"
                                                    Width="14"
                                                    Height="14"
                                                    Fill="#33C0C0C0" />
                                                <Border
                                                    Grid.Column="2"
                                                    Height="6"
                                                    VerticalAlignment="Center"
                                                    Background="#15FFFFFF"
                                                    CornerRadius="3" />
                                                <TextBlock
                                                    Grid.Column="3"
                                                    VerticalAlignment="Center"
                                                    FontSize="8"
                                                    Text="🪙" />
                                            </Grid>
                                        </StackPanel>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Gift Rank Vertical" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Gift Ranking Horizontal  -->
                            <Border
                                x:Name="LayoutGiftRankHorizontal"
                                Width="130"
                                Padding="0"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="LayoutCard_Click"
                                Tag="GiftRankHorizontal">
                                <Grid>
                                    <StackPanel Padding="10,10,10,8" Spacing="4">
                                        <Grid Height="42" Margin="4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel
                                                Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="2">
                                                <Ellipse
                                                    Width="16"
                                                    Height="16"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33C0C0C0" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="7"
                                                    Text="🪙" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="1"
                                                Margin="0,0,0,6"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="2">
                                                <Ellipse
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33FFD700" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="8"
                                                    Text="🪙" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="2"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Bottom"
                                                Spacing="2">
                                                <Ellipse
                                                    Width="14"
                                                    Height="14"
                                                    HorizontalAlignment="Center"
                                                    Fill="#33CD7F32" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="7"
                                                    Text="🪙" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="9"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            Text="Gift Rank Horiz." />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  ── THEME PREVIEW PICKER ──  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            CharacterSpacing="150"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="THEME" />
                        <GridView
                            x:Name="ThemePicker"
                            IsItemClickEnabled="True"
                            ItemClick="ThemeCard_Click"
                            SelectionMode="None">
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid
                                        ItemHeight="80"
                                        ItemWidth="166"
                                        MaximumRowsOrColumns="3"
                                        Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                            <GridView.ItemContainerStyle>
                                <Style TargetType="GridViewItem">
                                    <Setter Property="Margin" Value="0,0,6,6" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                </Style>
                            </GridView.ItemContainerStyle>
                        </GridView>
                    </StackPanel>

                    <!--  ── STYLE PICKER ──  -->
                    <StackPanel Spacing="8">
                        <TextBlock
                            CharacterSpacing="150"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="STYLE" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="10">
                            <!--  Default  -->
                            <Border
                                x:Name="StyleDefault"
                                Width="130"
                                Padding="10,10,10,8"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource NeonBlueBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="StyleCard_Click"
                                Tag="Default">
                                <StackPanel Spacing="4">
                                    <StackPanel Height="30" Spacing="3">
                                        <Border Height="12" Background="#22FFFFFF" CornerRadius="4" />
                                        <Border Height="12" Background="#15FFFFFF" CornerRadius="4" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Default" />
                                </StackPanel>
                            </Border>

                            <!--  Compact  -->
                            <Border
                                x:Name="StyleCompact"
                                Width="130"
                                Padding="10,10,10,8"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="StyleCard_Click"
                                Tag="Compact">
                                <StackPanel Spacing="4">
                                    <StackPanel Height="30" Spacing="2">
                                        <Border Height="8" Background="#22FFFFFF" CornerRadius="3" />
                                        <Border Height="8" Background="#15FFFFFF" CornerRadius="3" />
                                        <Border Height="8" Background="#10FFFFFF" CornerRadius="3" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Compact" />
                                </StackPanel>
                            </Border>

                            <!--  Minimal  -->
                            <Border
                                x:Name="StyleMinimal"
                                Width="130"
                                Padding="10,10,10,8"
                                Background="{StaticResource CardBgBrush}"
                                BorderBrush="{StaticResource DarkBg3Brush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                PointerPressed="StyleCard_Click"
                                Tag="Minimal">
                                <StackPanel Spacing="4">
                                    <StackPanel Height="30" Spacing="3">
                                        <Border
                                            Height="12"
                                            Background="#08FFFFFF"
                                            BorderBrush="#15FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                        <Border
                                            Height="12"
                                            Background="#08FFFFFF"
                                            BorderBrush="#10FFFFFF"
                                            BorderThickness="1"
                                            CornerRadius="4" />
                                    </StackPanel>
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="9"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Text="Minimal" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!--  Stats toggles  -->
                    <Grid x:Name="RankingSettingsPanel" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Show" />
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="16">
                            <CheckBox
                                x:Name="ShowHPCheck"
                                Content="HP"
                                FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="ShowDmgCheck"
                                Content="DMG"
                                FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsChecked="True" />
                            <CheckBox
                                x:Name="ShowKillsCheck"
                                Content="KILLS"
                                FontSize="12"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                IsChecked="True" />
                        </StackPanel>
                    </Grid>

                    <!--  ── GIFT WALL PICKER (visible only when GiftWall selected) ──  -->
                    <StackPanel
                        x:Name="GiftWallPanel"
                        Spacing="8"
                        Visibility="Collapsed">
                        <TextBlock
                            CharacterSpacing="150"
                            FontSize="10"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="SELECT GIFTS FOR OVERLAY" />

                        <!--  Search box for gifts  -->
                        <AutoSuggestBox
                            x:Name="OverlayGiftSearch"
                            FontSize="12"
                            GotFocus="OverlayGiftSearch_GotFocus"
                            PlaceholderText="Search gifts to add..."
                            QuerySubmitted="OverlayGiftSearch_QuerySubmitted"
                            SuggestionChosen="OverlayGiftSearch_SuggestionChosen"
                            TextChanged="OverlayGiftSearch_TextChanged"
                            UpdateTextOnSelect="False">
                            <AutoSuggestBox.QueryIcon>
                                <SymbolIcon Symbol="Find" />
                            </AutoSuggestBox.QueryIcon>
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="models:TikTokGift">
                                    <Grid Padding="4,4" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Grid.Column="0"
                                            Width="32"
                                            Height="32"
                                            Background="#FF1A1A2E"
                                            CornerRadius="4">
                                            <Image
                                                Width="28"
                                                Height="28"
                                                Source="{x:Bind DisplayImageUrl}"
                                                Stretch="UniformToFill" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="#FFE0E0FF"
                                            Text="{x:Bind Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="3">
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="#FFFF9500"
                                                Text="{x:Bind DisplayText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>

                        <!--  Selected gifts display  -->
                        <Border
                            MinHeight="60"
                            Padding="8"
                            Background="{StaticResource DarkBg2Brush}"
                            BorderBrush="{StaticResource DarkBg3Brush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <StackPanel>
                                <TextBlock
                                    x:Name="SelectedGiftsCountText"
                                    Margin="0,0,0,6"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    Text="0 gifts selected" />
                                <ItemsControl x:Name="SelectedGiftsList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!--  Gift text labels  -->
                        <StackPanel
                            x:Name="GiftTextLabelsPanel"
                            Spacing="6"
                            Visibility="Collapsed">
                            <TextBlock
                                CharacterSpacing="120"
                                FontSize="10"
                                FontWeight="Bold"
                                Foreground="{StaticResource NeonPurpleBrush}"
                                Text="GIFT TEXT LABELS (optional)" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="Add custom text to display beside each gift in the overlay" />
                            <StackPanel x:Name="GiftTextInputsList" Spacing="6" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Max Players & Refresh (plain TextBox)  -->
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Max" />
                        <TextBox
                            x:Name="MaxPlayersBox"
                            Grid.Column="1"
                            Width="60"
                            FontSize="12"
                            InputScope="Number"
                            MaxLength="2"
                            Style="{StaticResource CyberpunkTextBoxStyle}"
                            Text="5"
                            TextAlignment="Center" />
                        <Border Grid.Column="2" />
                        <TextBlock
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="Refresh" />
                        <StackPanel
                            Grid.Column="4"
                            Orientation="Horizontal"
                            Spacing="6">
                            <TextBox
                                x:Name="RefreshBox"
                                Width="70"
                                FontSize="12"
                                InputScope="Number"
                                MaxLength="5"
                                Style="{StaticResource CyberpunkTextBoxStyle}"
                                Text="2000"
                                TextAlignment="Center" />
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="ms" />
                        </StackPanel>
                    </Grid>

                    <!--  Create button  -->
                    <Button
                        x:Name="CreateSaveBtn"
                        Margin="0,2,0,0"
                        Padding="20,10"
                        HorizontalAlignment="Left"
                        Click="CreateOverlay_Click"
                        FontSize="12"
                        Style="{StaticResource CyberpunkAccentButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon
                                x:Name="CreateSaveBtnIcon"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Glyph="&#xE710;" />
                            <TextBlock x:Name="CreateSaveBtnText" Text="Create Overlay" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!--  ═══ OVERLAY LIST ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{StaticResource NeonBlueBrush}"
                            Glyph="&#xE8A9;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="YOUR OVERLAYS" />
                        <TextBlock
                            x:Name="OverlayCountText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="(0)" />
                    </StackPanel>

                    <!--  Empty state  -->
                    <Border
                        x:Name="OverlayEmptyState"
                        Padding="20"
                        Background="{StaticResource DarkBg2Brush}"
                        CornerRadius="8">
                        <StackPanel HorizontalAlignment="Center" Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="No overlays created yet" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Opacity="0.6"
                                Text="Create one above to get started" />
                        </StackPanel>
                    </Border>

                    <!--  Overlay items  -->
                    <ListView
                        x:Name="OverlayListView"
                        IsItemClickEnabled="False"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="14,10"
                                    Background="{StaticResource CardBgBrush}"
                                    BorderBrush="{StaticResource DarkBg3Brush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Grid.Column="0"
                                            Width="36"
                                            Height="36"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource DarkBg2Brush}"
                                            CornerRadius="8">
                                            <FontIcon
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="16"
                                                Foreground="{Binding ThemeAccentBrush}"
                                                Glyph="{Binding LayoutGlyph}" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{Binding LayoutLabel}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="•" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{Binding ThemeAccentBrush}"
                                                    Text="{Binding ThemeLabel}" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="•" />
                                                <TextBlock
                                                    FontSize="10"
                                                    Foreground="{StaticResource TextSecondaryBrush}"
                                                    Text="{Binding StatsLabel}" />
                                            </StackPanel>
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="10"
                                                Foreground="{StaticResource NeonGreenBrush}"
                                                IsTextSelectionEnabled="True"
                                                Opacity="0.8"
                                                Text="{Binding Url}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                FontFamily="Consolas"
                                                FontSize="10"
                                                Foreground="{StaticResource NeonPurpleBrush}"
                                                IsTextSelectionEnabled="True"
                                                Opacity="0.8"
                                                Text="{Binding CloudUrl}"
                                                TextTrimming="CharacterEllipsis"
                                                Visibility="{Binding HasCloudUrl}" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="6">
                                            <Button
                                                Padding="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CopyUrl_Click"
                                                Tag="{Binding Url}"
                                                ToolTipService.ToolTip="Copy local URL">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{StaticResource NeonBlueBrush}"
                                                    Glyph="&#xE8C8;" />
                                            </Button>
                                            <Button
                                                Padding="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="CopyUrl_Click"
                                                Tag="{Binding CloudUrl}"
                                                ToolTipService.ToolTip="Copy cloud URL"
                                                Visibility="{Binding HasCloudUrl}">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{StaticResource NeonPurpleBrush}"
                                                    Glyph="&#xE753;" />
                                            </Button>
                                            <Button
                                                Padding="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="PreviewOverlay_Click"
                                                Tag="{Binding Url}"
                                                ToolTipService.ToolTip="Preview in browser">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{StaticResource NeonGreenBrush}"
                                                    Glyph="&#xE7B3;" />
                                            </Button>
                                            <Button
                                                Padding="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="EditOverlay_Click"
                                                Tag="{Binding Id}"
                                                ToolTipService.ToolTip="Edit overlay">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{StaticResource NeonPurpleBrush}"
                                                    Glyph="&#xE70F;" />
                                            </Button>
                                            <Button
                                                Padding="8"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Click="DeleteOverlay_Click"
                                                Tag="{Binding Id}"
                                                ToolTipService.ToolTip="Delete overlay">
                                                <FontIcon
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Foreground="{StaticResource NeonPinkBrush}"
                                                    Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

            <!--  ═══ SETUP GUIDE ═══  -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="18"
                            Foreground="{StaticResource NeonPurpleBrush}"
                            Glyph="&#xE946;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            CharacterSpacing="100"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="SETUP GUIDE" />
                    </StackPanel>

                    <TextBlock
                        CharacterSpacing="80"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonPurpleBrush}"
                        Text="CLOUD OVERLAY (TikTok Studio / Remote OBS)" />
                    <StackPanel Padding="4,0,0,0" Spacing="6">
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">1.</Run>
                            <Run>Create an overlay with your preferred theme and layout</Run>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">2.</Run>
                            <Run>Click "Start Cloud Relay" — your data is pushed to Cloudflare automatically</Run>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">3.</Run>
                            <Run>Copy the</Run>
                            <Run FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource NeonPurpleBrush}">&#xE753;</Run>
                            <Run>cloud URL and paste it into TikTok Studio or OBS as a Browser Source</Run>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock
                        Margin="0,8,0,0"
                        CharacterSpacing="80"
                        FontSize="11"
                        FontWeight="Bold"
                        Foreground="{StaticResource NeonBlueBrush}"
                        Text="LOCAL OVERLAY (OBS on same PC)" />
                    <StackPanel Padding="4,0,0,0" Spacing="6">
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">1.</Run>
                            <Run>Start the Overlay Server above</Run>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">2.</Run>
                            <Run>Create an overlay with your preferred theme and layout</Run>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">3.</Run>
                            <Run>Click the</Run>
                            <Run FontFamily="Segoe MDL2 Assets">&#xE8C8;</Run>
                            <Run>copy button to copy the local URL</Run>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">4.</Run>
                            <Run>In OBS: Sources → Add → Browser Source → paste URL</Run>
                        </TextBlock>
                        <TextBlock
                            FontSize="12"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap">
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonBlueBrush}">5.</Run>
                            <Run>Set width=</Run>
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonGreenBrush}">400</Run>
                            <Run>for vertical, or width=</Run>
                            <Run FontWeight="SemiBold" Foreground="{StaticResource NeonGreenBrush}">800</Run>
                            <Run>for horizontal layout</Run>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Foreground="{StaticResource NeonPurpleBrush}">Tip:</Run>
                        <Run>You can create multiple overlays with different themes and layouts! Each gets its own unique cloud and local URL.</Run>
                    </TextBlock>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
