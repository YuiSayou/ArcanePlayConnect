<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.EventLogPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:LogCategoryToBrushConverter x:Key="LogCategoryToBrush" />
        <conv:LogCategoryToTagConverter x:Key="LogCategoryToTag" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="EVENT LOG" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource NeonGreenBrush}" CharacterSpacing="100" />
                <TextBlock Text="Real-time event stream from TikFinity"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>
            <Button Grid.Column="1" Command="{x:Bind ViewModel.ClearLogsCommand}"
                    Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="11" Padding="12,6"
                    Margin="0,0,8,0" VerticalAlignment="Top"
                    ToolTipService.ToolTip="Clear all logs">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    <TextBlock Text="Clear" />
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Command="{x:Bind ViewModel.CopyAllLogsCommand}"
                    Style="{StaticResource CyberpunkButtonStyle}" FontSize="11" Padding="12,6"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                    <TextBlock Text="Copy All" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="2" Background="{StaticResource DarkBg2Brush}"
                CornerRadius="6" Padding="14,8">
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox IsChecked="{x:Bind ViewModel.ShowSystemLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FF888888" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="System" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowChatLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FF00C8FF" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Chat" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowFollowLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FFB400FF" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Follow" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowGiftLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FFFF3278" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Gift" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowLikeLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FFFF5050" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Like" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowShareLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FFFF9500" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Share" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowSubscribeLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FFFFD700" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Subscribe" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
                <CheckBox IsChecked="{x:Bind ViewModel.ShowWebhookLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                            <Ellipse.Fill><SolidColorBrush Color="#FF00FF88" /></Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Text="Webhook" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </CheckBox>
            </StackPanel>
        </Border>

        <!-- Log list -->
        <Border Grid.Row="4" Style="{StaticResource PanelBorderStyle}" Padding="8">
            <ListView x:Name="LogListView"
                      ItemsSource="{x:Bind ViewModel.FilteredLogs, Mode=OneWay}"
                      Background="Transparent" SelectionMode="Single" IsItemClickEnabled="False"
                      ContainerContentChanging="LogListView_ContainerContentChanging">
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="4,4" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Copy" Click="CopyLogEntry_Click">
                                        <MenuFlyoutItem.Icon>
                                            <SymbolIcon Symbol="Copy" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </Grid.ContextFlyout>
                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                       FontFamily="Consolas" VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True" />
                            <Border Grid.Column="1" CornerRadius="3" Padding="5,2"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Background="{Binding Category, Converter={StaticResource LogCategoryToBrush}}"
                                    Opacity="0.18">
                                <TextBlock Text="{Binding Category, Converter={StaticResource LogCategoryToTag}}"
                                           Foreground="{Binding Category, Converter={StaticResource LogCategoryToBrush}}"
                                           FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                       IsTextSelectionEnabled="True" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>
