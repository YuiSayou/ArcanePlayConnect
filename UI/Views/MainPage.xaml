<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.MainPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ArcanePlayConnect.UI.Views"
    xmlns:vm="using:ArcanePlayConnect.UI.ViewModels"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:LogLevelToBrushConverter x:Key="LogLevelToBrush" />
        <conv:LogLevelToTagConverter x:Key="LogLevelToTag" />
        <conv:LogCategoryToBrushConverter x:Key="LogCategoryToBrush" />
        <conv:LogCategoryToTagConverter x:Key="LogCategoryToTag" />
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBoolConverter x:Key="InverseBool" />
        <conv:ActionTypeToBrushConverter x:Key="ActionTypeToBrush" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource DarkBg2Brush}" 
                BorderBrush="{StaticResource DarkBg3Brush}" BorderThickness="0,0,0,1"
                Padding="16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="⚡" FontSize="18" VerticalAlignment="Center" />
                    <TextBlock Text="ARCANE PLAY CONNECT" FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource NeonBlueBrush}" VerticalAlignment="Center"
                               CharacterSpacing="120" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="20" 
                            VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource NeonPurpleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="TikTok:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.TiktokStatus, Mode=OneWay}" Foreground="{StaticResource NeonPurpleBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.IsListenerRunning, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="Webhook:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.WebhookStatus, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{x:Bind ViewModel.IsRconConnected, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}" VerticalAlignment="Center" />
                        <TextBlock Text="RCON:" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.RconStatus, Mode=OneWay}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ═══════════════ LEFT PANEL: Profiles ═══════════════ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Profile List Card -->
                <Border Grid.Row="0" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PROFILES" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource NeonPurpleBrush}" CharacterSpacing="150"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="+" Command="{x:Bind ViewModel.CreateProfileCommand}"
                                    Style="{StaticResource CyberpunkButtonStyle}" FontSize="13" Padding="8,2"
                                    ToolTipService.ToolTip="Create new profile" />
                        </Grid>

                        <!-- Profile List -->
                        <ListView Grid.Row="1" 
                                  ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                                  SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                                  Background="Transparent"
                                  SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="6,8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" CornerRadius="2
                                                " Background="{StaticResource NeonPurpleBrush}" />
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProfileName}" 
                                                       Foreground="{StaticResource TextPrimaryBrush}" 
                                                       FontSize="13" FontWeight="SemiBold" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding GameType}" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                <TextBlock Text="•" 
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="10">
                                                    <Run Text="Port " /><Run Text="{Binding WebhookPort}" />
                                                </TextBlock>
                                            </StackPanel>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="▸" 
                                                   Foreground="{StaticResource NeonBlueBrush}" FontSize="14"
                                                   VerticalAlignment="Center" Opacity="0.5" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Action row -->
                        <Grid Grid.Row="2" Margin="0,8,0,0" ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="✏️ Edit" 
                                    Command="{x:Bind ViewModel.EditSelectedProfileCommand}"
                                    Style="{StaticResource CyberpunkButtonStyle}" 
                                    HorizontalAlignment="Stretch" FontSize="11" Padding="0,5" />
                            <Button Grid.Column="1" Content="🗑 Delete" 
                                    Command="{x:Bind ViewModel.DeleteProfileCommand}"
                                    Style="{StaticResource CyberpunkDangerButtonStyle}" 
                                    HorizontalAlignment="Stretch" FontSize="11" Padding="0,5" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- Profile Editor (collapsible) -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}"
                        Visibility="{x:Bind ViewModel.IsProfileEditorOpen, Converter={StaticResource BoolToVisibility}, Mode=OneWay}"
                        MaxHeight="420">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
                        <StackPanel Spacing="8">
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EDIT PROFILE" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="120"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="✕" 
                                        Click="CloseProfileEditor_Click"
                                        Background="Transparent" Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="12" Padding="6,2" BorderThickness="0"
                                        ToolTipService.ToolTip="Close editor" />
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="Name" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Text="{x:Bind ViewModel.EditProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" />
                            </StackPanel>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="80" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="Game" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Text="{x:Bind ViewModel.EditGameType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="WH Port" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <NumberBox Value="{x:Bind ViewModel.EditWebhookPort, Mode=TwoWay}"
                                               Minimum="1" Maximum="65535"
                                               SpinButtonPlacementMode="Hidden" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="RCON IP" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBox Text="{x:Bind ViewModel.EditRconIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="Port" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                    <NumberBox Value="{x:Bind ViewModel.EditRconPort, Mode=TwoWay}"
                                               Minimum="1" Maximum="65535"
                                               SpinButtonPlacementMode="Hidden" FontSize="12" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="3">
                                <TextBlock Text="RCON Password" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                <PasswordBox Password="{x:Bind ViewModel.EditRconPassword, Mode=TwoWay}" FontSize="12" />
                            </StackPanel>

                            <Button Content="💾 Save Changes" Command="{x:Bind ViewModel.SaveProfileCommand}"
                                    Style="{StaticResource CyberpunkAccentButtonStyle}"
                                    HorizontalAlignment="Stretch" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- ═══════════════ MAIN PANEL ═══════════════ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>

                    <!-- ═══ EVENT LOG ═══ -->
                    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Header row -->
                            <Grid Grid.Row="0" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="EVENT LOG" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="150"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="🗑" 
                                        Command="{x:Bind ViewModel.ClearLogsCommand}"
                                        Style="{StaticResource CyberpunkButtonStyle}" 
                                        FontSize="10" Padding="6,3" Margin="0,0,6,0"
                                        ToolTipService.ToolTip="Clear logs" />
                                <Button Grid.Column="2" Content="📋 Copy" 
                                        Command="{x:Bind ViewModel.CopyAllLogsCommand}"
                                        Style="{StaticResource CyberpunkButtonStyle}" 
                                        FontSize="10" Padding="8,3" />
                            </Grid>

                            <!-- Filter checkboxes -->
                            <Border Grid.Row="1" Background="{StaticResource DarkBg2Brush}" 
                                    CornerRadius="4" Padding="10,5" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal" Spacing="14">
                                    <CheckBox IsChecked="{x:Bind ViewModel.ShowSystemLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#FF888888" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Sys" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{x:Bind ViewModel.ShowChatLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#FF00C8FF" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Chat" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{x:Bind ViewModel.ShowFollowLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#FFB400FF" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Follow" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{x:Bind ViewModel.ShowGiftLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#FFFF3278" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Gift" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{x:Bind ViewModel.ShowLikeLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#FFFF5050" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Like" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox IsChecked="{x:Bind ViewModel.ShowWebhookLogs, Mode=TwoWay}" MinWidth="0" Padding="4,0,0,0">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                                <Ellipse.Fill>
                                                    <SolidColorBrush Color="#FF00FF88" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="Webhook" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!-- Log list -->
                            <ListView Grid.Row="2" 
                                      x:Name="LogListView"
                                      ItemsSource="{x:Bind ViewModel.FilteredLogs, Mode=OneWay}"
                                      Background="Transparent"
                                      SelectionMode="Single"
                                      IsItemClickEnabled="False"
                                      ContainerContentChanging="LogListView_ContainerContentChanging">
                                <ListView.ItemContainerTransitions>
                                    <TransitionCollection />
                                </ListView.ItemContainerTransitions>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Padding="0,3" ColumnSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50" />
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Copy" Click="CopyLogEntry_Click">
                                                        <MenuFlyoutItem.Icon>
                                                            <SymbolIcon Symbol="Copy" />
                                                        </MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Grid.ContextFlyout>
                                            <TextBlock Grid.Column="0" Text="{Binding FormattedTime}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="10"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" />
                                            <Border Grid.Column="1" CornerRadius="3" Padding="4,1"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Background="{Binding Category, Converter={StaticResource LogCategoryToBrush}}"
                                                    Opacity="0.18">
                                                <TextBlock Text="{Binding Category, Converter={StaticResource LogCategoryToTag}}"
                                                           Foreground="{Binding Category, Converter={StaticResource LogCategoryToBrush}}"
                                                           FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}"
                                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"
                                                       TextWrapping="Wrap" VerticalAlignment="Center"
                                                       IsTextSelectionEnabled="True" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </Border>

                    <!-- ═══ ACTION MAPPINGS ═══ -->
                    <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="ACTION MAPPINGS" FontSize="12" FontWeight="Bold"
                                           Foreground="{StaticResource NeonPurpleBrush}" CharacterSpacing="150"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <ListView Grid.Row="1"
                                      x:Name="MappingsList"
                                      ItemsSource="{x:Bind ViewModel.CurrentMappings, Mode=OneWay}"
                                      Background="Transparent"
                                      SelectionMode="None">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ActionMappingItem">
                                        <Grid Padding="0,5" ColumnSpacing="5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Type badge -->
                                            <Border Grid.Column="0" CornerRadius="4" Padding="5,2"
                                                    VerticalAlignment="Center"
                                                    Background="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                                    Opacity="0.18">
                                                <TextBlock Text="{x:Bind TriggerTypeLabel}" FontSize="12"
                                                           Foreground="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}" />
                                            </Border>

                                            <!-- Trigger key -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{x:Bind TriggerDisplay}"
                                                       Foreground="{x:Bind TriggerType, Converter={StaticResource ActionTypeToBrush}, Mode=OneWay}"
                                                       FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <TextBlock Grid.Column="2" Text="→"
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" />

                                            <!-- Command -->
                                            <TextBlock Grid.Column="3" Text="{x:Bind Command}"
                                                       Foreground="{StaticResource NeonGreenBrush}" FontSize="11"
                                                       FontFamily="Consolas" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- Test button -->
                                            <Button Grid.Column="4"
                                                    Content="&#x25B6;"
                                                    Click="TestMapping_Click"
                                                    Tag="{x:Bind}"
                                                    Background="Transparent" Foreground="{StaticResource NeonGreenBrush}"
                                                    FontSize="10" Padding="4,2" BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Test this mapping (uses TestPlayer as nickname)" />

                                            <!-- Remove button -->
                                            <Button Grid.Column="5"
                                                    Content="&#xE74D;"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    Click="RemoveMapping_Click"
                                                    Tag="{x:Bind}"
                                                    Background="Transparent" Foreground="{StaticResource NeonPinkBrush}"
                                                    FontSize="11" Padding="4,2" BorderThickness="0"
                                                    VerticalAlignment="Center"
                                                    ToolTipService.ToolTip="Remove this mapping" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- Add button -->
                            <Button Grid.Row="2" Content="＋ Add Action Mapping"
                                    Command="{x:Bind ViewModel.OpenAddActionDialogCommand}"
                                    Style="{StaticResource CyberpunkButtonStyle}"
                                    HorizontalAlignment="Stretch" FontSize="11"
                                    Margin="0,8,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- BOTTOM PANEL -->
                <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="▶ Start Listener" Command="{x:Bind ViewModel.StartListenerCommand}"
                                    Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" />
                            <Button Content="⏹ Stop Listener" Command="{x:Bind ViewModel.StopListenerCommand}"
                                    Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" />
                            <Border Width="1" Background="{StaticResource DarkBg3Brush}" Margin="8,4" />
                            <Button Content="🔌 Connect RCON" Command="{x:Bind ViewModel.ConnectRconCommand}"
                                    Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" />
                            <Button Content="⛔ Disconnect RCON" Command="{x:Bind ViewModel.DisconnectRconCommand}"
                                    Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox Text="{x:Bind ViewModel.TestCommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CyberpunkTextBoxStyle}" Width="250" FontSize="12"
                                     PlaceholderText="Test command..." />
                            <Button Content="⚡ Test" Command="{x:Bind ViewModel.TestCommandCommand}"
                                    Style="{StaticResource CyberpunkButtonStyle}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom glow line -->
        <Border Grid.Row="2" Height="2">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FF00C8FF" Offset="0.0" />
                    <GradientStop Color="#FFB400FF" Offset="0.5" />
                    <GradientStop Color="#FFFF3278" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>
    </Grid>
</Page>
