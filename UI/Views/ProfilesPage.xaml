<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.ProfilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>

    <Grid Padding="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: Profile list -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="PROFILES" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource NeonPinkBrush}" CharacterSpacing="100" />
                <TextBlock Text="Manage connection profiles"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Profile list -->
            <Border Grid.Row="2" Style="{StaticResource PanelBorderStyle}" Padding="8">
                <ListView ItemsSource="{x:Bind ViewModel.Profiles, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedProfile, Mode=TwoWay}"
                          Background="Transparent" SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="10,10" ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" CornerRadius="2"
                                        Background="{StaticResource NeonPurpleBrush}" />
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProfileName}"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding GameType}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Text="|"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11">
                                            <Run Text="Port " /><Run Text="{Binding WebhookPort}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <!-- Action buttons -->
            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{x:Bind ViewModel.CreateProfileCommand}"
                        Style="{StaticResource CyberpunkAccentButtonStyle}"
                        HorizontalAlignment="Stretch" FontSize="11" Padding="0,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="New" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1" Command="{x:Bind ViewModel.EditSelectedProfileCommand}"
                        Style="{StaticResource CyberpunkButtonStyle}"
                        HorizontalAlignment="Stretch" FontSize="11" Padding="0,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Edit" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Command="{x:Bind ViewModel.DeleteProfileCommand}"
                        Style="{StaticResource CyberpunkDangerButtonStyle}"
                        HorizontalAlignment="Stretch" FontSize="11" Padding="0,8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Right: Editor -->
        <Border Grid.Column="2" Style="{StaticResource PanelBorderStyle}"
                Visibility="{x:Bind ViewModel.IsProfileEditorOpen, Converter={StaticResource BoolToVisibility}, Mode=OneWay}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="16" MaxWidth="500">
                    <!-- Editor header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="EDIT PROFILE" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Click="CloseEditor_Click"
                                Background="Transparent" BorderThickness="0" Padding="8,4"
                                ToolTipService.ToolTip="Close editor">
                            <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                      Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Profile Name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBox Text="{x:Bind ViewModel.EditProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="13" />
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Game Type" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.EditGameType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="Webhook Port" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <NumberBox Value="{x:Bind ViewModel.EditWebhookPort, Mode=TwoWay}"
                                       Minimum="1" Maximum="65535"
                                       SpinButtonPlacementMode="Hidden" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="80" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="RCON IP" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBox Text="{x:Bind ViewModel.EditRconIP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="13" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="RCON Port" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                            <NumberBox Value="{x:Bind ViewModel.EditRconPort, Mode=TwoWay}"
                                       Minimum="1" Maximum="65535"
                                       SpinButtonPlacementMode="Hidden" FontSize="13" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="5">
                        <TextBlock Text="RCON Password" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        <PasswordBox Password="{x:Bind ViewModel.EditRconPassword, Mode=TwoWay}" FontSize="13" />
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.SaveProfileCommand}"
                            Style="{StaticResource CyberpunkAccentButtonStyle}"
                            HorizontalAlignment="Stretch" Padding="0,12" FontSize="13" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14" />
                            <TextBlock Text="Save Changes" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Placeholder when editor is closed -->
        <Border Grid.Column="2"
                Visibility="{x:Bind ViewModel.IsProfileEditorOpen, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert, Mode=OneWay}"
                Style="{StaticResource PanelBorderStyle}" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="8" HorizontalAlignment="Center" Padding="40,30">
                <FontIcon Glyph="&#xE748;" FontFamily="Segoe MDL2 Assets" FontSize="36"
                          Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="Select a profile and click Edit" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
