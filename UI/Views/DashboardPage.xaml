<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" MaxWidth="700">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="DASHBOARD" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="100" />
                <TextBlock Text="Connection controls and server testing"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- Webhook Card -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xEC05;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource NeonGreenBrush}" />
                            <TextBlock Text="WEBHOOK LISTENER" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{x:Bind ViewModel.IsListenerRunning, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.WebhookStatus, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                        <Button Command="{x:Bind ViewModel.StartListenerCommand}"
                                Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Start" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.StopListenerCommand}"
                                Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Stop" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RCON Card -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource NeonPurpleBrush}" />
                            <TextBlock Text="RCON CONNECTION" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{x:Bind ViewModel.IsRconConnected, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.RconStatus, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
                        <Button Command="{x:Bind ViewModel.ConnectRconCommand}"
                                Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE703;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Connect" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.DisconnectRconCommand}"
                                Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Test Command Card -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                  Foreground="{StaticResource NeonBlueBrush}" />
                        <TextBlock Text="TEST COMMAND" FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{x:Bind ViewModel.TestCommandText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource CyberpunkTextBoxStyle}" FontSize="12"
                                 FontFamily="Consolas"
                                 PlaceholderText="Enter a command to test..." />
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.TestCommandCommand}"
                                Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="20,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Send" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
