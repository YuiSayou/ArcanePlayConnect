<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel Spacing="20" MaxWidth="700">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="DASHBOARD" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="100" />
                <TextBlock Text="TikTok Live connection and live stats"
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- TikTok Live Card -->
            <Border Style="{StaticResource PanelBorderStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
                            <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                      Foreground="{StaticResource NeonPurpleBrush}" />
                            <TextBlock Text="TIKTOK LIVE" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" CharacterSpacing="100"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{x:Bind ViewModel.IsTikTokConnected, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.TikTokLiveStatus, Mode=OneWay}"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- Live stats counters -->
                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Viewer counter card -->
                        <Border Grid.Column="0" Background="#FF12121E" CornerRadius="8" Padding="16,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                              Foreground="{StaticResource NeonBlueBrush}" />
                                    <TextBlock Text="VIEWERS" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="ViewerCountText" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource NeonBlueBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Likes counter card -->
                        <Border Grid.Column="1" Background="#FF12121E" CornerRadius="8" Padding="16,12">
                            <StackPanel Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                              Foreground="{StaticResource NeonPinkBrush}" />
                                    <TextBlock Text="LIKES" FontSize="9" FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="120"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="LikesCountText" Text="0" FontSize="28" FontWeight="Bold"
                                           Foreground="{StaticResource NeonPinkBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10">
                        <Button Command="{x:Bind ViewModel.ConnectTikTokCommand}"
                                Style="{StaticResource CyberpunkAccentButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Connect" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.DisconnectTikTokCommand}"
                                Style="{StaticResource CyberpunkDangerButtonStyle}" FontSize="12" Padding="16,8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                <TextBlock Text="Disconnect" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
