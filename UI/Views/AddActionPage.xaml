<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.AddActionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ArcanePlayConnect.Core.Models"
    xmlns:controls="using:ArcanePlayConnect.UI.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0A0A14">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1" />
            <ColumnDefinition Width="200" />
        </Grid.ColumnDefinitions>

        <!-- ??? LEFT: Main form ??? -->
        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <Grid Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                  Foreground="#FF00C8FF" VerticalAlignment="Center" />
                        <TextBlock Text="ADD ACTION MAPPING" FontSize="15" FontWeight="Bold"
                                   Foreground="#FF00C8FF" CharacterSpacing="120" VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Height="1" Margin="0,6,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF00C8FF" Offset="0.0" />
                                <GradientStop Color="#FFB400FF" Offset="0.5" />
                                <GradientStop Color="#FFFF3278" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </StackPanel>

                <!-- Trigger Type selector -->
                <StackPanel Grid.Row="2" Spacing="6">
                    <TextBlock Text="TRIGGER TYPE" FontSize="10" FontWeight="Bold"
                               Foreground="#FF8888AA" CharacterSpacing="120" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="GiftTypeBtn" Grid.Column="0" CornerRadius="6" Padding="10,10"
                                Background="#FF1E1E36" BorderThickness="2" BorderBrush="#FFFF3278"
                                PointerPressed="TriggerType_PointerPressed" Tag="Gift">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8E1;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                          HorizontalAlignment="Center" Foreground="#FFFF3278" />
                                <TextBlock x:Name="GiftLabel" Text="GIFT" FontSize="10" FontWeight="Bold"
                                           Foreground="#FFFF3278" HorizontalAlignment="Center" CharacterSpacing="100" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="FollowTypeBtn" Grid.Column="1" CornerRadius="6" Padding="10,10"
                                Background="#FF16162A" BorderThickness="2" BorderBrush="#FF1A1A2E"
                                PointerPressed="TriggerType_PointerPressed" Tag="Follow">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                          HorizontalAlignment="Center" Foreground="#FF8888AA" />
                                <TextBlock x:Name="FollowLabel" Text="FOLLOW" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF8888AA" HorizontalAlignment="Center" CharacterSpacing="100" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="ChatTypeBtn" Grid.Column="2" CornerRadius="6" Padding="10,10"
                                Background="#FF16162A" BorderThickness="2" BorderBrush="#FF1A1A2E"
                                PointerPressed="TriggerType_PointerPressed" Tag="Chat">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                          HorizontalAlignment="Center" Foreground="#FF8888AA" />
                                <TextBlock x:Name="ChatLabel" Text="CHAT" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF8888AA" HorizontalAlignment="Center" CharacterSpacing="100" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="LikeTypeBtn" Grid.Column="3" CornerRadius="6" Padding="10,10"
                                Background="#FF16162A" BorderThickness="2" BorderBrush="#FF1A1A2E"
                                PointerPressed="TriggerType_PointerPressed" Tag="Like">
                            <StackPanel Spacing="4" HorizontalAlignment="Center">
                                <FontIcon Glyph="&#xEB51;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                          HorizontalAlignment="Center" Foreground="#FF8888AA" />
                                <TextBlock x:Name="LikeLabel" Text="LIKE" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF8888AA" HorizontalAlignment="Center" CharacterSpacing="100" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Trigger Key -->
                <StackPanel Grid.Row="4" Spacing="6" x:Name="TriggerKeyPanel">
                    <TextBlock x:Name="TriggerKeyLabel" Text="GIFT NAME" FontSize="10" FontWeight="Bold"
                               Foreground="#FF8888AA" CharacterSpacing="120" />
                    <TextBox x:Name="TriggerKeyBox"
                             PlaceholderText="e.g. Rose"
                             Background="#FF12121E" Foreground="#FFE0E0FF"
                             BorderBrush="#FF1A1A2E" BorderThickness="1"
                             Padding="10,8" CornerRadius="4" FontSize="13" />
                </StackPanel>

                <!-- Command / Button Action -->
                <StackPanel Grid.Row="6" Spacing="6">
                    <!-- Action mode selector -->
                    <StackPanel Spacing="5">
                        <TextBlock Text="ACTION" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF8888AA" CharacterSpacing="120" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="ActionCommandBtn" Grid.Column="0" CornerRadius="6" Padding="8,8"
                                    Background="#FF1E1E36" BorderThickness="2" BorderBrush="#FF00FF88"
                                    PointerPressed="ActionMode_PointerPressed" Tag="Command">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                              Foreground="#FF00FF88" />
                                    <TextBlock x:Name="ActionCommandLabel" Text="RCON Command" FontSize="11"
                                               FontWeight="Bold" Foreground="#FF00FF88" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="ActionButtonBtn" Grid.Column="1" CornerRadius="6" Padding="8,8"
                                    Background="#FF16162A" BorderThickness="2" BorderBrush="#FF1A1A2E"
                                    PointerPressed="ActionMode_PointerPressed" Tag="Button">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                              Foreground="#FF8888AA" />
                                    <TextBlock x:Name="ActionButtonLabel" Text="Trigger Button" FontSize="11"
                                               FontWeight="Bold" Foreground="#FF8888AA" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Command input panel -->
                    <StackPanel x:Name="CommandPanel" Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="RCON COMMAND" FontSize="10" FontWeight="Bold"
                                       Foreground="#FF8888AA" CharacterSpacing="120" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="use {nickname} for player name"
                                       FontSize="9" Foreground="#FF00FF88" VerticalAlignment="Center" FontWeight="SemiBold" />
                        </Grid>
                        <controls:CommandSuggestionBox x:Name="CommandBox"
                                 PlaceholderText="e.g. execute as {username} at @s run summon zombie ^ ^ ^2 {CustomName:&quot;{nickname}&quot;,CustomNameVisible:1b}"
                                 TextChanged="CommandBox_TextChanged" />
                        <Border x:Name="CommandHintBorder" CornerRadius="4" Padding="8,5"
                                Background="#FF0D1F0D" BorderBrush="#FF00FF88" BorderThickness="1">
                            <TextBlock x:Name="CommandHintText"
                                       FontSize="9" FontFamily="Consolas"
                                       Foreground="#FF00FF88" TextWrapping="Wrap"
                                       Text="Type braces normally: {CustomName:...}  &#x0A;Use {nickname} where you want the player name." />
                        </Border>

                        <!-- Save command row -->
                        <Grid ColumnSpacing="6" Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SaveLabelBox"
                                     Grid.Column="0"
                                     PlaceholderText="Label to save as..."
                                     Background="#FF12121E" Foreground="#FFE0E0FF"
                                     BorderBrush="#FF1A1A2E" BorderThickness="1"
                                     Padding="10,7" CornerRadius="4" FontSize="11" />
                            <Button Grid.Column="1" Content="Save to Library"
                                    Click="SaveCommand_Click"
                                    Background="#FF1E1E36" Foreground="#FF00FF88"
                                    BorderBrush="#FF00FF88" BorderThickness="1"
                                    CornerRadius="4" FontWeight="SemiBold" FontSize="11"
                                    Padding="10,7" />
                        </Grid>
                    </StackPanel>

                    <!-- Button selector panel -->
                    <StackPanel x:Name="ButtonPanel" Spacing="6" Visibility="Collapsed">
                        <TextBlock Text="SELECT BUTTON" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF8888AA" CharacterSpacing="120" />
                        <ComboBox x:Name="ButtonCombo" HorizontalAlignment="Stretch"
                                  PlaceholderText="Choose a command button..."
                                  Background="#FF12121E" FontSize="12" />
                        <Border CornerRadius="4" Padding="8,5"
                                Background="#FF1F1A0D" BorderBrush="#FFFF9500" BorderThickness="1">
                            <TextBlock FontSize="9" Foreground="#FFFF9500" TextWrapping="Wrap"
                                       Text="Create buttons in the Command Buttons page first. The selected button's full command sequence will run when this mapping triggers." />
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <Grid Grid.Row="8" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="Cancel"
                            Click="Cancel_Click"
                            HorizontalAlignment="Stretch" Padding="0,10"
                            Background="#FF1E1E36" Foreground="#FFFF3278"
                            BorderBrush="#FFFF3278" BorderThickness="1"
                            CornerRadius="4" FontWeight="SemiBold" FontSize="13" />

                    <Button Grid.Column="1" Content="Add Action"
                            Click="Add_Click"
                            HorizontalAlignment="Stretch" Padding="0,10"
                            CornerRadius="4" FontWeight="Bold" FontSize="13"
                            Foreground="White" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#FF00C8FF" Offset="0.0" />
                                <GradientStop Color="#FFB400FF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Button.Background>
                    </Button>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- Divider -->
        <Border Grid.Column="1" Background="#FF1A1A2E" />

        <!-- ??? RIGHT: Saved commands library ??? -->
        <Grid Grid.Column="2" Background="#FF0D0D1A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Library header -->
            <Border Grid.Row="0" Padding="12,14,12,10"
                    BorderBrush="#FF1A1A2E" BorderThickness="0,0,0,1">
                <TextBlock Text="COMMAND LIBRARY" FontSize="10" FontWeight="Bold"
                           Foreground="#FF00FF88" CharacterSpacing="120" />
            </Border>

            <!-- Saved command list -->
            <ListView x:Name="SavedCommandsList"
                      Grid.Row="1"
                      Background="Transparent"
                      SelectionMode="Single"
                      ItemClick="SavedCommand_ItemClick"
                      IsItemClickEnabled="True"
                      Padding="6,4">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SavedCommand">
                        <Grid Padding="6,6" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Label}"
                                           Foreground="#FFE0E0FF" FontSize="11" FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Command}"
                                           Foreground="#FF8888AA" FontSize="9"
                                           FontFamily="Consolas"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets" FontSize="10"
                                    Click="DeleteSavedCommand_Click"
                                    Tag="{x:Bind}"
                                    Background="Transparent" Foreground="#FF8888AA"
                                    BorderThickness="0" Padding="4,2"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
