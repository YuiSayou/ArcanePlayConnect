<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ArcanePlayConnect.UI.Views.ShellPage"
    x:Name="Shell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:ArcanePlayConnect.UI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DarkBgBrush}">

    <Page.Resources>
        <conv:BoolToStatusBrushConverter x:Key="BoolToStatusBrush" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ??????? LEFT NAV RAIL ??????? -->
        <Border Grid.Column="0" Background="#FF0D0D1A"
                BorderBrush="{StaticResource DarkBg3Brush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- App branding -->
                <Border Grid.Row="0" Padding="16,16,16,12">
                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                      Foreground="{StaticResource NeonBlueBrush}" />
                            <TextBlock Text="ARCANE PLAY" FontSize="14" FontWeight="Bold"
                                       Foreground="{StaticResource NeonBlueBrush}" CharacterSpacing="80"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="CONNECT" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" CharacterSpacing="200"
                                   Margin="28,0,0,0" />
                        <!-- Gradient line -->
                        <Border Height="2" CornerRadius="1" Margin="0,6,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF00C8FF" Offset="0" />
                                    <GradientStop Color="#FFB400FF" Offset="0.5" />
                                    <GradientStop Color="#FFFF3278" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Nav items -->
                <StackPanel Grid.Row="1" Spacing="2" Padding="8,4">
                    <Button x:Name="NavDashboard" Click="NavButton_Click" Tag="Dashboard"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource NeonBlueBrush}" />
                            <TextBlock Text="Dashboard" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavEventLog" Click="NavButton_Click" Tag="EventLog"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource NeonGreenBrush}" />
                            <TextBlock Text="Event Log" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavTriggers" Click="NavButton_Click" Tag="Triggers"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE8CB;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource NeonPurpleBrush}" />
                            <TextBlock Text="Triggers" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavActions" Click="NavButton_Click" Tag="Actions"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="#FFFF9500" />
                            <TextBlock Text="Actions" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavMinecraft" Click="NavButton_Click" Tag="Minecraft"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource NeonGreenBrush}" />
                            <TextBlock Text="Minecraft" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavOverlays" Click="NavButton_Click" Tag="Overlays"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource NeonGreenBrush}" />
                            <TextBlock Text="OBS Overlays" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavFollowers" Click="NavButton_Click" Tag="Followers"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="#FFB400FF" />
                            <TextBlock Text="Follower Database" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="NavProfiles" Click="NavButton_Click" Tag="Profiles"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="12,10" CornerRadius="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE748;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                      Foreground="{StaticResource NeonPinkBrush}" />
                            <TextBlock Text="Profiles" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Spacer -->
                <Border Grid.Row="2" />

                <!-- Status indicators -->
                <Border Grid.Row="3" Padding="16,8" Background="#FF0A0A14"
                        BorderBrush="{StaticResource DarkBg3Brush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="8">
                        <TextBlock Text="STATUS" FontSize="9" FontWeight="Bold" CharacterSpacing="200"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="6" Height="6"
                                     Fill="{x:Bind ViewModel.IsTikTokConnected, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="TikTok" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.TikTokLiveStatus, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="6" Height="6"
                                     Fill="{x:Bind ViewModel.IsRconConnected, Converter={StaticResource BoolToStatusBrush}, Mode=OneWay}"
                                     VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="RCON" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RconStatus, Mode=OneWay}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active profile -->
                <Border Grid.Row="4" Padding="16,10" Background="#FF0A0A14"
                        BorderBrush="{StaticResource DarkBg3Brush}" BorderThickness="0,1,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="ACTIVE PROFILE" FontSize="9" FontWeight="Bold" CharacterSpacing="200"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.SelectedProfile.ProfileName, Mode=OneWay, FallbackValue='None'}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource NeonPurpleBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ??????? CONTENT FRAME ??????? -->
        <Frame Grid.Column="1" x:Name="ContentFrame" />
    </Grid>
</Page>
