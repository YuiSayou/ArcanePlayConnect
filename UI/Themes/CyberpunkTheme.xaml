<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Cyberpunk Color Brushes  -->
    <SolidColorBrush x:Key="NeonBlueBrush" Color="#FF00C8FF" />
    <SolidColorBrush x:Key="NeonPurpleBrush" Color="#FFB400FF" />
    <SolidColorBrush x:Key="NeonPinkBrush" Color="#FFFF3278" />
    <SolidColorBrush x:Key="NeonGreenBrush" Color="#FF00FF88" />
    <SolidColorBrush x:Key="DarkBgBrush" Color="#FF0A0A14" />
    <SolidColorBrush x:Key="DarkBg2Brush" Color="#FF12121E" />
    <SolidColorBrush x:Key="DarkBg3Brush" Color="#FF1A1A2E" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="#FF16162A" />
    <SolidColorBrush x:Key="CardBgBrush" Color="#FF1E1E36" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFE0E0FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#FF8888AA" />

    <!--  Gradient Brushes  -->
    <LinearGradientBrush x:Key="NeonGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#FF00C8FF" />
        <GradientStop Offset="0.5" Color="#FFB400FF" />
        <GradientStop Offset="1.0" Color="#FFFF3278" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.0" Color="#FF00C8FF" />
        <GradientStop Offset="1.0" Color="#FFB400FF" />
    </LinearGradientBrush>

    <!--  Cyberpunk Button Style  -->
    <Style x:Key="CyberpunkButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NeonBlueBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonBlueBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  Accent Button  -->
    <Style x:Key="CyberpunkAccentButtonStyle" TargetType="Button">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Offset="0.0" Color="#FF00C8FF" />
                    <GradientStop Offset="1.0" Color="#FFB400FF" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <!--  Danger Button  -->
    <Style x:Key="CyberpunkDangerButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBgBrush}" />
        <Setter Property="Foreground" Value="{StaticResource NeonPinkBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource NeonPinkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!--  TextBox Style  -->
    <Style x:Key="CyberpunkTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource DarkBg2Brush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBg3Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="CornerRadius" Value="4" />
    </Style>

    <!--  Panel Border Style  -->
    <Style x:Key="PanelBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="BorderBrush" Value="{StaticResource DarkBg3Brush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
